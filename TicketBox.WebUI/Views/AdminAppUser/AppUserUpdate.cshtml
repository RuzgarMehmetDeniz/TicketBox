@model UpdateAppUserCommand
@{
    ViewData["Title"] = "AppUserUpdate";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="topbar">
    <div class="topbar-left">
        <button class="menu-toggle" id="menuToggle">☰</button>
        <div>
            <div class="page-title" id="pageTitle">Kullanıcı Güncelle</div>
            <div class="page-sub" id="pageSub">Kullanıcı profili ve tercihlerini düzenleyin</div>
        </div>
    </div>
    <div class="topbar-right">
        <div class="theme-switch" id="themeSwitch">
            <button class="theme-btn" id="themeBtn"><span class="theme-dot" id="themeDot"></span> Tema ▾</button>
            <div class="theme-menu" id="themeMenu">
                <button class="theme-opt active" data-theme="midnight"><span class="sw" style="background:linear-gradient(135deg,#7C5CFF,#4F8CFF)"></span> 🌙 Midnight</button>
                <button class="theme-opt" data-theme="aurora"><span class="sw" style="background:linear-gradient(135deg,#34D8C7,#6C5CE7)"></span> 🌌 Aurora</button>
                <button class="theme-opt" data-theme="purple"><span class="sw" style="background:linear-gradient(135deg,#A855F7,#EC4899)"></span> 💜 Purple</button>
                <button class="theme-opt" data-theme="ocean"><span class="sw" style="background:linear-gradient(135deg,#2DA8FF,#00C2D1)"></span> 💙 Ocean</button>
                <button class="theme-opt" data-theme="graphite"><span class="sw" style="background:linear-gradient(135deg,#9CA3AF,#6B7280)"></span> 🩶 Graphite</button>
                <button class="theme-opt" data-theme="light"><span class="sw" style="background:linear-gradient(135deg,#7C5CFF,#00B894)"></span> 🤍 Light</button>
            </div>
        </div>
        <div class="admin-mini" style="padding:6px 10px;"><div class="av" style="width:30px;height:30px;"></div></div>
    </div>
</div>

<div class="content">
    <section class="view active">
        <div class="view-head">
            <div><h2>Kullanıcı Güncelle</h2><p>Kullanıcı bilgilerini ve tercihlerini güncelleyin.</p></div>
            <div class="head-actions">
                <a class="btn btn-ghost" href="@Url.Action("AppUserList", "AdminAppUser")">← Listeye Dön</a>
            </div>
        </div>

        <div class="card" style="max-width:580px;margin:0 auto;">
            <form asp-controller="AdminAppUser" asp-action="AppUserUpdate" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />

                <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
                    <div class="f-row">
                        <label>Ad</label>
                        <input type="text" asp-for="Name" />
                        <span asp-validation-for="Name" style="color:var(--danger);font-size:11.5px;"></span>
                    </div>
                    <div class="f-row">
                        <label>Soyad</label>
                        <input type="text" asp-for="Surname" />
                        <span asp-validation-for="Surname" style="color:var(--danger);font-size:11.5px;"></span>
                    </div>
                </div>

                <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
                    <div class="f-row">
                        <label>Kullanıcı Adı</label>
                        <input type="text" asp-for="UserName" />
                        <span asp-validation-for="UserName" style="color:var(--danger);font-size:11.5px;"></span>
                    </div>
                    <div class="f-row">
                        <label>Yaş</label>
                        <input type="number" asp-for="Age" />
                        <span asp-validation-for="Age" style="color:var(--danger);font-size:11.5px;"></span>
                    </div>
                </div>

                <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
                    <div class="f-row">
                        <label>Şehir</label>
                        <input type="text" asp-for="City" />
                        <span asp-validation-for="City" style="color:var(--danger);font-size:11.5px;"></span>
                    </div>
                    <div class="f-row">
                        <label>Ülke</label>
                        <input type="text" asp-for="Country" />
                        <span asp-validation-for="Country" style="color:var(--danger);font-size:11.5px;"></span>
                    </div>
                </div>

                <div class="f-row">
                    <label>Profil Resmi URL</label>
                    <input type="text" asp-for="ProfileImageUrl" placeholder="https://..." />
                    <span asp-validation-for="ProfileImageUrl" style="color:var(--danger);font-size:11.5px;"></span>
                </div>

                <div class="f-row">
                    <label>Tercih Edilen Kategoriler</label>
                    <input type="text" asp-for="PreferredCategories" placeholder="Müzik, Tiyatro, Festival" />
                    <span asp-validation-for="PreferredCategories" style="color:var(--danger);font-size:11.5px;"></span>
                </div>

                <div style="display:flex;gap:10px;margin-top:15px;">
                    <button type="submit" class="btn btn-primary">Güncelle</button>
                    <a class="btn btn-ghost" href="@Url.Action("AppUserList", "AdminAppUser")">Vazgeç</a>
                </div>
            </form>
        </div>
    </section>
</div>