@model CreateChatMessageCommand
@{
    ViewData["Title"] = "ChatMessageCreate";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="topbar">
    <div class="topbar-left">
        <button class="menu-toggle" id="menuToggle">☰</button>
        <div>
            <div class="page-title" id="pageTitle">Yeni Mesaj Ekle</div>
            <div class="page-sub" id="pageSub">Manuel sohbet mesajı kaydı oluşturun</div>
        </div>
    </div>
    <div class="topbar-right">
        <div class="theme-switch" id="themeSwitch">
            <button class="theme-btn" id="themeBtn"><span class="theme-dot" id="themeDot"></span> Tema ▾</button>
            <div class="theme-menu" id="themeMenu">
                <button class="theme-opt active" data-theme="midnight"><span class="sw" style="background:linear-gradient(135deg,#7C5CFF,#4F8CFF)"></span> 🌙 Midnight</button>
                <button class="theme-opt" data-theme="aurora"><span class="sw" style="background:linear-gradient(135deg,#34D8C7,#6C5CE7)"></span> 🌌 Aurora</button>
                <button class="theme-opt" data-theme="purple"><span class="sw" style="background:linear-gradient(135deg,#A855F7,#EC4899)"></span> 💜 Purple</button>
                <button class="theme-opt" data-theme="ocean"><span class="sw" style="background:linear-gradient(135deg,#2DA8FF,#00C2D1)"></span> 💙 Ocean</button>
                <button class="theme-opt" data-theme="graphite"><span class="sw" style="background:linear-gradient(135deg,#9CA3AF,#6B7280)"></span> 🩶 Graphite</button>
                <button class="theme-opt" data-theme="light"><span class="sw" style="background:linear-gradient(135deg,#7C5CFF,#00B894)"></span> 🤍 Light</button>
            </div>
        </div>
        <div class="admin-mini" style="padding:6px 10px;"><div class="av" style="width:30px;height:30px;"></div></div>
    </div>
</div>

<div class="content">
    <section class="view active">
        <div class="view-head">
            <div><h2>Yeni Mesaj</h2><p>Oturuma ait sohbet mesajı oluşturmak için bilgileri girin.</p></div>
            <div class="head-actions">
                <a class="btn btn-ghost" href="@Url.Action("ChatMessageList", "AdminChatMessage")">← Listeye Dön</a>
            </div>
        </div>

        <div class="card" style="max-width:580px;margin:0 auto;">
            <form asp-controller="AdminChatMessage" asp-action="ChatMessageCreate" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" style="color:var(--danger);font-size:12px;margin-bottom:12px;"></div>

                <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
                    <div class="f-row">
                        <label>Sohbet Oturum ID</label>
                        <input type="number" asp-for="ChatSessionId" placeholder="1" />
                        <span asp-validation-for="ChatSessionId" style="color:var(--danger);font-size:11.5px;"></span>
                    </div>
                    <div class="f-row">
                        <label>Gönderen</label>
                        <select asp-for="Sender">
                            <option value="">Seçiniz</option>
                            <option value="User">User</option>
                            <option value="Bot">Bot</option>
                        </select>
                        <span asp-validation-for="Sender" style="color:var(--danger);font-size:11.5px;"></span>
                    </div>
                </div>

                <div class="f-row">
                    <label>Mesaj İçeriği</label>
                    <textarea asp-for="Content" rows="4" placeholder="Mesajınızı yazın..."></textarea>
                    <span asp-validation-for="Content" style="color:var(--danger);font-size:11.5px;"></span>
                </div>

                <div style="display:flex;gap:10px;margin-top:15px;">
                    <button type="submit" class="btn btn-primary">Kaydet</button>
                    <a class="btn btn-ghost" href="@Url.Action("ChatMessageList", "AdminChatMessage")">Vazgeç</a>
                </div>
            </form>
        </div>
    </section>
</div>