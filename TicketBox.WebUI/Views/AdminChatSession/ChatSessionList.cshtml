@model List<GetChatSessionQueryResult>
@{
    ViewData["Title"] = "ChatSessionList";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="topbar">
    <div class="topbar-left">
        <button class="menu-toggle" id="menuToggle">☰</button>
        <div>
            <div class="page-title" id="pageTitle">Sohbet Oturumları</div>
            <div class="page-sub" id="pageSub">Aktif ve geçmiş canlı destek oturumlarını takip edin</div>
        </div>
    </div>
    <div class="topbar-right">
        <div class="search-box"><span>🔍</span><input placeholder="Oturum veya kullanıcı ara..."></div>
        <button class="icon-btn">🔔<span class="dot"></span></button>
        <div class="theme-switch" id="themeSwitch">
            <button class="theme-btn" id="themeBtn"><span class="theme-dot" id="themeDot"></span> Tema ▾</button>
            <div class="theme-menu" id="themeMenu">
                <button class="theme-opt active" data-theme="midnight"><span class="sw" style="background:linear-gradient(135deg,#7C5CFF,#4F8CFF)"></span> 🌙 Midnight</button>
                <button class="theme-opt" data-theme="aurora"><span class="sw" style="background:linear-gradient(135deg,#34D8C7,#6C5CE7)"></span> 🌌 Aurora</button>
                <button class="theme-opt" data-theme="purple"><span class="sw" style="background:linear-gradient(135deg,#A855F7,#EC4899)"></span> 💜 Purple</button>
                <button class="theme-opt" data-theme="ocean"><span class="sw" style="background:linear-gradient(135deg,#2DA8FF,#00C2D1)"></span> 💙 Ocean</button>
                <button class="theme-opt" data-theme="graphite"><span class="sw" style="background:linear-gradient(135deg,#9CA3AF,#6B7280)"></span> 🩶 Graphite</button>
                <button class="theme-opt" data-theme="light"><span class="sw" style="background:linear-gradient(135deg,#7C5CFF,#00B894)"></span> 🤍 Light</button>
            </div>
        </div>
        <div class="admin-mini" style="padding:6px 10px;"><div class="av" style="width:30px;height:30px;"></div></div>
    </div>
</div>

<div class="content">
    <section class="view active" id="view-chat-sessions">
        <div class="view-head">
            <div><h2>Sohbet Oturum Yönetimi</h2><p>Kullanıcılara ait açılmış canlı destek ve bot oturum listesi.</p></div>
            <div class="head-actions">
                <a class="btn btn-primary" href="@Url.Action("ChatSessionCreate", "AdminChatSession")">+ Yeni Oturum Başlat</a>
            </div>
        </div>
        <div class="table-card">
            <div class="table-toolbar">
                <div class="search-box" style="width:260px;"><span>🔍</span><input placeholder="Kullanıcı ID veya Oturum ID ara..."></div>
            </div>
            <table>
                <thead>
                    <tr>
                        <th style="width:15%;">Oturum ID</th>
                        <th style="width:40%;">Kullanıcı ID</th>
                        <th style="width:30%;">Başlangıç Tarihi</th>
                        <th style="width:15%;text-align:right;">İşlem</th>
                    </tr>
                </thead>
                <tbody id="chatSessionsBody">
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td><span class="badge badge-secondary">#@item.ChatSessionId</span></td>
                                <td>
                                    <div style="font-weight:600;font-family:monospace;">@item.AppUserId</div>
                                </td>
                                <td>@item.StartedDate.ToString("dd.MM.yyyy HH:mm:ss")</td>
                                <td>
                                    <div class="row-actions">
                                        <a class="btn-icon-only" title="Düzenle" href="@Url.Action("ChatSessionUpdate", "AdminChatSession", new { id = item.ChatSessionId })">✎</a>
                                        <form method="post" action="@Url.Action("ChatSessionDelete", "AdminChatSession")" style="display:inline;" onsubmit="return confirm('Bu oturumu ve bağlı mesajları silmek istediğinize emin misiniz?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.ChatSessionId" />
                                            <button type="submit" class="btn-icon-only" title="Sil" style="color:var(--danger);">🗑</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="empty-hint">Henüz başlatılmış sohbet oturumu bulunamadı.</td>
                        </tr>
                    }
                </tbody>
            </table>
            <div class="table-foot">
                <span>@(Model?.Count ?? 0) kayıt gösteriliyor</span>
            </div>
        </div>
    </section>
</div>