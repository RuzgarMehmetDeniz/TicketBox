@model List<GetEventQueryResult>
@{
    ViewData["Title"] = "EventList";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="topbar">
    <div class="topbar-left">
        <button class="menu-toggle" id="menuToggle">☰</button>
        <div>
            <div class="page-title" id="pageTitle">Etkinlikler</div>
            <div class="page-sub" id="pageSub">Tüm etkinlikleri görüntüle, düzenle veya kaldır</div>
        </div>
    </div>
    <div class="topbar-right">
        <div class="search-box"><span>🔍</span><input placeholder="Etkinlik ara..."></div>
        <button class="icon-btn">🔔<span class="dot"></span></button>
        <div class="theme-switch" id="themeSwitch">
            <button class="theme-btn" id="themeBtn"><span class="theme-dot" id="themeDot"></span> Tema ▾</button>
            <div class="theme-menu" id="themeMenu">
                <button class="theme-opt active" data-theme="midnight"><span class="sw" style="background:linear-gradient(135deg,#7C5CFF,#4F8CFF)"></span> 🌙 Midnight</button>
                <button class="theme-opt" data-theme="aurora"><span class="sw" style="background:linear-gradient(135deg,#34D8C7,#6C5CE7)"></span> 🌌 Aurora</button>
                <button class="theme-opt" data-theme="purple"><span class="sw" style="background:linear-gradient(135deg,#A855F7,#EC4899)"></span> 💜 Purple</button>
                <button class="theme-opt" data-theme="ocean"><span class="sw" style="background:linear-gradient(135deg,#2DA8FF,#00C2D1)"></span> 💙 Ocean</button>
                <button class="theme-opt" data-theme="graphite"><span class="sw" style="background:linear-gradient(135deg,#9CA3AF,#6B7280)"></span> 🩶 Graphite</button>
                <button class="theme-opt" data-theme="light"><span class="sw" style="background:linear-gradient(135deg,#7C5CFF,#00B894)"></span> 🤍 Light</button>
            </div>
        </div>
        <div class="admin-mini" style="padding:6px 10px;"><div class="av" style="width:30px;height:30px;"></div></div>
    </div>
</div>

<div class="content">
    <section class="view active" id="view-events" data-filter-scope="events">
        <div class="view-head">
            <div><h2>Etkinlik Yönetimi</h2><p>Tüm etkinlikleri görüntüle, düzenle veya kaldır.</p></div>
            <div class="head-actions">
                <a class="btn btn-primary" href="@Url.Action("EventCreate", "AdminEvent")">+ Yeni Etkinlik</a>
            </div>
        </div>
        <div class="table-card">
            <div class="table-toolbar">
                <div class="filter-chips">
                    <button class="f-chip active" data-filter="all">Tümü (@(Model?.Count ?? 0))</button>
                    <button class="f-chip" data-filter="active">Yayında</button>
                    <button class="f-chip" data-filter="inactive">Pasif</button>
                </div>
                <div class="search-box" style="width:220px;"><span>🔍</span><input placeholder="Etkinlik ara..."></div>
            </div>
            <table>
                <thead>
                    <tr>
                        <th>Etkinlik</th>
                        <th>Kategori</th>
                        <th>Tarih</th>
                        <th>Konum</th>
                        <th>Kapasite</th>
                        <th>Fiyat</th>
                        <th>Durum</th>
                        <th style="text-align:right;">İşlem</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr data-status="@(item.IsActive ? "active" : "inactive")">
                                <td>
                                    <div class="cell-main">
                                        <div class="cell-avatar"></div>
                                        <div>
                                            <div class="cell-title">@item.Title</div>
                                            <div class="cell-sub">@item.RemainingCapacity / @item.Capacity kalan</div>
                                        </div>
                                    </div>
                                </td>
                                <td><span class="badge blue">@item.CategoryName</span></td>
                                <td>@item.EventDate.ToString("dd.MM.yyyy HH:mm")</td>
                                <td>@item.Location</td>
                                <td>@item.Capacity</td>
                                <td><b>₺@item.Price.ToString("N0")</b></td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge green">Yayında</span>
                                    }
                                    else
                                    {
                                        <span class="badge gray">Pasif</span>
                                    }
                                </td>
                                <td>
                                    <div class="row-actions">
                                        <a class="btn-icon-only" title="Düzenle" href="@Url.Action("EventUpdate", "AdminEvent", new { id = item.EventId })">✎</a>
                                        <form method="post" action="@Url.Action("EventDelete", "AdminEvent")" style="display:inline;" onsubmit="return confirm('Bu etkinliği silmek istediğinize emin misiniz?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.EventId" />
                                            <button type="submit" class="btn-icon-only" title="Sil" style="color:var(--danger);">🗑</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="8" class="empty-hint">Henüz etkinlik eklenmemiş.</td></tr>
                    }
                </tbody>
            </table>
            <div class="table-foot"><span>@(Model?.Count ?? 0) kayıt gösteriliyor</span></div>
        </div>
    </section>
</div>

<script>
    (function () {
        const view = document.querySelector('[data-filter-scope="events"]');
        if (!view) return;
        const chipGroup = view.querySelector('.filter-chips');
        const tbody = view.querySelector('tbody');
        if (!chipGroup || !tbody) return;
        chipGroup.querySelectorAll('.f-chip').forEach(chip => {
            chip.addEventListener('click', () => {
                chipGroup.querySelectorAll('.f-chip').forEach(c => c.classList.remove('active'));
                chip.classList.add('active');
                const filter = chip.dataset.filter;
                tbody.querySelectorAll('tr[data-status]').forEach(row => {
                    row.style.display = (filter === 'all' || row.dataset.status === filter) ? '' : 'none';
                });
            });
        });
    })();
</script>