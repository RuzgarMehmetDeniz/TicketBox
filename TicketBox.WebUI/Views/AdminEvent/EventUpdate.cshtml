@model UpdateEventCommand
@{
    ViewData["Title"] = "EventUpdate";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}
<div class="topbar">
    <div class="topbar-left">
        <button class="menu-toggle" id="menuToggle">☰</button>
        <div>
            <div class="page-title" id="pageTitle">Etkinlik Düzenle</div>
            <div class="page-sub" id="pageSub">@Model.Title etkinliğini güncelle</div>
        </div>
    </div>
    <div class="topbar-right">
        <div class="theme-switch" id="themeSwitch">
            <button class="theme-btn" id="themeBtn"><span class="theme-dot" id="themeDot"></span> Tema ▾</button>
            <div class="theme-menu" id="themeMenu">
                <button class="theme-opt active" data-theme="midnight"><span class="sw" style="background:linear-gradient(135deg,#7C5CFF,#4F8CFF)"></span> 🌙 Midnight</button>
                <button class="theme-opt" data-theme="aurora"><span class="sw" style="background:linear-gradient(135deg,#34D8C7,#6C5CE7)"></span> 🌌 Aurora</button>
                <button class="theme-opt" data-theme="purple"><span class="sw" style="background:linear-gradient(135deg,#A855F7,#EC4899)"></span> 💜 Purple</button>
                <button class="theme-opt" data-theme="ocean"><span class="sw" style="background:linear-gradient(135deg,#2DA8FF,#00C2D1)"></span> 💙 Ocean</button>
                <button class="theme-opt" data-theme="graphite"><span class="sw" style="background:linear-gradient(135deg,#9CA3AF,#6B7280)"></span> 🩶 Graphite</button>
                <button class="theme-opt" data-theme="light"><span class="sw" style="background:linear-gradient(135deg,#7C5CFF,#00B894)"></span> 🤍 Light</button>
            </div>
        </div>
        <div class="admin-mini" style="padding:6px 10px;"><div class="av" style="width:30px;height:30px;"></div></div>
    </div>
</div>

<div class="content">
    <section class="view active">
        <div class="view-head">
            <div><h2>Etkinlik Düzenle</h2><p>@Model.Title etkinliğini güncelle.</p></div>
            <div class="head-actions"><a class="btn btn-ghost" href="@Url.Action("EventList", "AdminEvent")">← Listeye Dön</a></div>
        </div>
        <div class="card" style="max-width:620px;margin:0 auto;">
            <form asp-controller="AdminEvent" asp-action="EventUpdate" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="EventId" />

                <div class="f-row">
                    <label>Başlık</label>
                    <input type="text" asp-for="Title" />
                    <span asp-validation-for="Title" style="color:var(--danger);font-size:11.5px;"></span>
                </div>

                <div class="f-row">
                    <label>Açıklama</label>
                    <textarea asp-for="Description"></textarea>
                    <span asp-validation-for="Description" style="color:var(--danger);font-size:11.5px;"></span>
                </div>

                <div class="f-row">
                    <label>Kategori</label>
                    <select asp-for="CategoryId" asp-items="@ViewBag.Categories" style="width:100%;padding:11px 14px;border-radius:10px;border:1px solid var(--border-strong);background:rgba(255,255,255,.03);color:var(--text);"></select>
                    <span asp-validation-for="CategoryId" style="color:var(--danger);font-size:11.5px;"></span>
                </div>

                <div class="f-row">
                    <label>Tarih & Saat</label>
                    <input type="datetime-local" asp-for="EventDate" />
                    <span asp-validation-for="EventDate" style="color:var(--danger);font-size:11.5px;"></span>
                </div>

                <div class="f-row">
                    <label>Konum</label>
                    <input type="text" asp-for="Location" />
                    <span asp-validation-for="Location" style="color:var(--danger);font-size:11.5px;"></span>
                </div>

                <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;">
                    <div class="f-row">
                        <label>Kapasite</label>
                        <input type="number" asp-for="Capacity" />
                        <span asp-validation-for="Capacity" style="color:var(--danger);font-size:11.5px;"></span>
                    </div>
                    <div class="f-row">
                        <label>Bilet Fiyatı (₺)</label>
                        <input type="number" step="0.01" asp-for="Price" />
                        <span asp-validation-for="Price" style="color:var(--danger);font-size:11.5px;"></span>
                    </div>
                </div>

                <div class="f-row">
                    <label>Görsel URL</label>
                    <input type="text" asp-for="ImageUrl" />
                </div>

                <div class="f-row" style="display:flex;align-items:center;gap:10px;">
                    <label class="switch">
                        <input type="checkbox" asp-for="IsActive" />
                        <span class="track"></span>
                    </label>
                    <label style="margin:0;">Yayında</label>
                </div>

                <div style="display:flex;gap:10px;margin-top:10px;">
                    <button type="submit" class="btn btn-primary">Güncelle</button>
                    <a class="btn btn-ghost" href="@Url.Action("EventList", "AdminEvent")">Vazgeç</a>
                </div>
            </form>
        </div>
    </section>
</div>