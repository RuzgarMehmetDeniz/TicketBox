@model List<GetEventGalleryQueryResult>
@{
    ViewData["Title"] = "EventGalleryList";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="topbar">
    <div class="topbar-left">
        <button class="menu-toggle" id="menuToggle">☰</button>
        <div>
            <div class="page-title" id="pageTitle">Etkinlik Galeri Yönetimi</div>
            <div class="page-sub" id="pageSub">Etkinliklere ait görselleri listeleyin ve yönetin</div>
        </div>
    </div>
    <div class="topbar-right">
        <div class="search-box"><span>🔍</span><input placeholder="Görsel veya etkinlik ara..."></div>
        <button class="icon-btn">🔔<span class="dot"></span></button>
        <div class="theme-switch" id="themeSwitch">
            <button class="theme-btn" id="themeBtn"><span class="theme-dot" id="themeDot"></span> Tema ▾</button>
            <div class="theme-menu" id="themeMenu">
                <button class="theme-opt active" data-theme="midnight"><span class="sw" style="background:linear-gradient(135deg,#7C5CFF,#4F8CFF)"></span> 🌙 Midnight</button>
                <button class="theme-opt" data-theme="aurora"><span class="sw" style="background:linear-gradient(135deg,#34D8C7,#6C5CE7)"></span> 🌌 Aurora</button>
                <button class="theme-opt" data-theme="purple"><span class="sw" style="background:linear-gradient(135deg,#A855F7,#EC4899)"></span> 💜 Purple</button>
                <button class="theme-opt" data-theme="ocean"><span class="sw" style="background:linear-gradient(135deg,#2DA8FF,#00C2D1)"></span> 💙 Ocean</button>
                <button class="theme-opt" data-theme="graphite"><span class="sw" style="background:linear-gradient(135deg,#9CA3AF,#6B7280)"></span> 🩶 Graphite</button>
                <button class="theme-opt" data-theme="light"><span class="sw" style="background:linear-gradient(135deg,#7C5CFF,#00B894)"></span> 🤍 Light</button>
            </div>
        </div>
        <div class="admin-mini" style="padding:6px 10px;"><div class="av" style="width:30px;height:30px;"></div></div>
    </div>
</div>

<div class="content">
    <section class="view active" id="view-event-galleries">
        <div class="view-head">
            <div><h2>Galeri Görselleri</h2><p>Sistemdeki tüm etkinlik galeri fotoğrafları.</p></div>
            <div class="head-actions">
                <a class="btn btn-primary" href="@Url.Action("EventGalleryCreate", "AdminEventGallery")">+ Yeni Görsel Ekle</a>
            </div>
        </div>
        <div class="table-card">
            <div class="table-toolbar">
                <div class="search-box" style="width:260px;"><span>🔍</span><input placeholder="Etkinlik adına göre ara..."></div>
            </div>
            <table>
                <thead>
                    <tr>
                        <th style="width:8%;">ID</th>
                        <th style="width:12%;">Önizleme</th>
                        <th style="width:30%;">Etkinlik Adı</th>
                        <th style="width:38%;">Görsel URL</th>
                        <th style="width:12%;text-align:right;">İşlem</th>
                    </tr>
                </thead>
                <tbody id="eventGalleriesBody">
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>#@item.EventGalleryId</td>
                                <td>
                                    <img src="@item.ImageUrl" alt="Galeri Görseli" style="width:50px;height:35px;object-fit:cover;border-radius:6px;border:1px solid rgba(255,255,255,0.1);" onerror="this.src='https://via.placeholder.com/50x35?text=No+Image'" />
                                </td>
                                <td><strong>@(string.IsNullOrEmpty(item.EventTitle) ? "—" : item.EventTitle)</strong></td>
                                <td>
                                    <div style="max-width:350px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-family:monospace;font-size:12px;" title="@item.ImageUrl">
                                        @item.ImageUrl
                                    </div>
                                </td>
                                <td>
                                    <div class="row-actions">
                                        <a class="btn-icon-only" title="Düzenle" href="@Url.Action("EventGalleryUpdate", "AdminEventGallery", new { id = item.EventGalleryId })">✎</a>
                                        <form method="post" action="@Url.Action("EventGalleryDelete", "AdminEventGallery")" style="display:inline;" onsubmit="return confirm('Bu galeri görselini silmek istediğinize emin misiniz?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.EventGalleryId" />
                                            <button type="submit" class="btn-icon-only" title="Sil" style="color:var(--danger);">🗑</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="empty-hint">Henüz eklenmiş galeri görseli bulunamadı.</td>
                        </tr>
                    }
                </tbody>
            </table>
            <div class="table-foot">
                <span>@(Model?.Count ?? 0) kayıt gösteriliyor</span>
            </div>
        </div>
    </section>
</div>