@model List<GetFavoriteQueryResult>
@{
    ViewData["Title"] = "FavoriteList";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="topbar">
    <div class="topbar-left">
        <button class="menu-toggle" id="menuToggle">☰</button>
        <div>
            <div class="page-title" id="pageTitle">Favoriler</div>
            <div class="page-sub" id="pageSub">Kullanıcıların favori etkinliklerini yönet</div>
        </div>
    </div>
    <div class="topbar-right">
        <div class="search-box"><span>🔍</span><input placeholder="Kullanıcı veya Etkinlik ara..."></div>
        <button class="icon-btn">🔔<span class="dot"></span></button>
        <div class="theme-switch" id="themeSwitch">
            <button class="theme-btn" id="themeBtn"><span class="theme-dot" id="themeDot"></span> Tema ▾</button>
            <div class="theme-menu" id="themeMenu">
                <button class="theme-opt active" data-theme="midnight"><span class="sw" style="background:linear-gradient(135deg,#7C5CFF,#4F8CFF)"></span> 🌙 Midnight</button>
                <button class="theme-opt" data-theme="aurora"><span class="sw" style="background:linear-gradient(135deg,#34D8C7,#6C5CE7)"></span> 🌌 Aurora</button>
                <button class="theme-opt" data-theme="purple"><span class="sw" style="background:linear-gradient(135deg,#A855F7,#EC4899)"></span> 💜 Purple</button>
                <button class="theme-opt" data-theme="ocean"><span class="sw" style="background:linear-gradient(135deg,#2DA8FF,#00C2D1)"></span> 💙 Ocean</button>
                <button class="theme-opt" data-theme="graphite"><span class="sw" style="background:linear-gradient(135deg,#9CA3AF,#6B7280)"></span> 🩶 Graphite</button>
                <button class="theme-opt" data-theme="light"><span class="sw" style="background:linear-gradient(135deg,#7C5CFF,#00B894)"></span> 🤍 Light</button>
            </div>
        </div>
        <div class="admin-mini" style="padding:6px 10px;"><div class="av" style="width:30px;height:30px;"></div></div>
    </div>
</div>

<div class="content">
    <section class="view active" id="view-favorites">
        <div class="view-head">
            <div><h2>Favori Listesi</h2><p>Tüm kullanıcı favori kayıtlarını görüntüleyin.</p></div>
            <div class="head-actions">
                <a class="btn btn-primary" href="@Url.Action("FavoriteCreate", "AdminFavorite")">+ Yeni Favori Ekle</a>
            </div>
        </div>
        <div class="table-card">
            <div class="table-toolbar">
                <div class="search-box" style="width:250px;"><span>🔍</span><input placeholder="Etkinlik Adı ara..."></div>
            </div>
            <table>
                <thead>
                    <tr>
                        <th style="width:10%;"># ID</th>
                        <th style="width:25%;">Kullanıcı ID</th>
                        <th style="width:15%;">Etkinlik ID</th>
                        <th style="width:35%;">Etkinlik Adı</th>
                        <th style="width:15%;text-align:right;">İşlem</th>
                    </tr>
                </thead>
                <tbody id="favoritesBody">
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model )
                        {
                            <tr>
                                <td>
                                    <div class="cell-main">
                                        <div class="cell-title" style="font-weight:600;color:var(--primary);">#@item.FavoriteId</div>
                                    </div>
                                </td
                                <td><span style="font-size:12px;opacity:0.8;">@item.AppUserId</span></td>
                                <td>@item.EventId</td>
                                <td>
                                    <span class="badge blue" style="background:rgba(59,130,246,0.15);color:#3b82f6;font-weight:600;">
                                        @(string.IsNullOrEmpty(item.EventTitle) ? "Etkinlik " + item.EventId : item.EventTitle)
                                    </span>
                                </td>
                                <td>
                                    <div class="row-actions">
                                        <a class="btn-icon-only" title="Düzenle" href="@Url.Action("FavoriteUpdate", "AdminFavorite", new { id = item.FavoriteId })">✎</a>
                                        <form method="post" action="@Url.Action("FavoriteDelete", "AdminFavorite")" style="display:inline;" onsubmit="return confirm('Bu favori kaydını silmek istediğinize emin misiniz?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.FavoriteId" />
                                            <button type="submit" class="btn-icon-only" title="Sil" style="color:var(--danger);">🗑</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="empty-hint">Henüz favori kaydı bulunamadı.</td>
                        </tr>
                    }
                </tbody>
            </table>
            <div class="table-foot">
                <span>Total @(Model?.Count ?? 0) kayıt gösteriliyor</span>
            </div>
        </div>
    </section>
</div>