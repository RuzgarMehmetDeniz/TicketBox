    <div class="modal-overlay" id="confirmModal">
        <div class="modal" style="max-width:400px;">
            <div class="modal-head"><h3>Emin misiniz?</h3><button class="btn-icon-only" onclick="closeModal('confirmModal')">✕</button></div>
            <div class="modal-body"><p style="font-size:13.5px;color:var(--subtitle);line-height:1.6;">Bu işlem geri alınamaz. Devam etmek istediğinize emin misiniz?</p></div>
            <div class="modal-foot"><button class="btn btn-ghost" onclick="closeModal('confirmModal')">Vazgeç</button><button class="btn btn-danger" onclick="saveAndToast('confirmModal','Kayıt silindi')">Evet, Sil</button></div>
        </div>
    </div>

    <div class="toast-wrap" id="toastWrap"></div>

    <script>
        /* ============ NAV / VIEW SWITCHING ============ */
        const titles = {
          dashboard:['Genel Bakış','Platformun anlık durumu ve performans özeti'],
          events:['Etkinlik Yönetimi','Tüm etkinlikleri görüntüle, onayla, düzenle veya kaldır'],
          categories:['Kategoriler','Etkinlik kategorilerini yönet'],
          cities:['Şehirler','Platformda hizmet verilen şehirleri yönet'],
          blog:['Blog Yönetimi','Blog yazılarını oluştur, düzenle ve yayınla'],
          sponsors:['Sponsorlar','İş ortaklarını ve sponsor logolarını yönet'],
          reviews:['Yorum Moderasyonu','Kullanıcı yorumlarını incele, onayla veya kaldır'],
          users:['Kullanıcılar','Platformdaki tüm kullanıcı hesaplarını yönet'],
          organizers:['Organizatörler','Organizatör hesaplarını ve onay başvurularını yönet'],
          orders:['Siparişler / Biletler','Tüm bilet siparişlerini görüntüle ve yönet'],
          finance:['Ödemeler / Finans','Platform geliri, komisyonlar ve organizatör ödemeleri'],
          notifications:['Bildirimler','Sistem ve kullanıcı bildirimleri'],
          settings:['Ayarlar & Roller','Platform ayarları ve yönetici izinleri'],
        };
        document.querySelectorAll('.nav-item[data-view]').forEach(item=>{
          item.addEventListener('click',()=>{
            document.querySelectorAll('.nav-item').forEach(i=>i.classList.remove('active'));
            item.classList.add('active');
            const v = item.dataset.view;
            document.querySelectorAll('.view').forEach(sec=>sec.classList.remove('active'));
            document.getElementById('view-'+v).classList.add('active');
            document.getElementById('pageTitle').textContent = titles[v][0];
            document.getElementById('pageSub').textContent = titles[v][1];
            if(window.innerWidth<=900) document.getElementById('sidebar').classList.remove('open');
          });
        });
        document.getElementById('menuToggle').addEventListener('click',()=>document.getElementById('sidebar').classList.toggle('open'));

        /* ============ THEME SWITCH ============ */
        const themeSwitch=document.getElementById('themeSwitch'), themeBtn=document.getElementById('themeBtn'), themeMenu=document.getElementById('themeMenu'), themeDot=document.getElementById('themeDot');
        themeBtn.addEventListener('click',e=>{e.stopPropagation();themeSwitch.classList.toggle('open');});
        document.addEventListener('click',()=>themeSwitch.classList.remove('open'));
        document.querySelectorAll('.theme-opt').forEach(opt=>{
          opt.addEventListener('click',()=>{
            document.body.setAttribute('data-theme', opt.dataset.theme);
            document.querySelectorAll('.theme-opt').forEach(o=>o.classList.remove('active'));
            opt.classList.add('active');
            themeDot.style.background = getComputedStyle(document.documentElement).getPropertyValue('--primary');
            refreshCharts();
          });
        });

        /* ============ SETTINGS TABS ============ */
        document.querySelectorAll('.settings-nav button').forEach(btn=>{
          btn.addEventListener('click',()=>{
            document.querySelectorAll('.settings-nav button').forEach(b=>b.classList.remove('active'));
            btn.classList.add('active');
            document.querySelectorAll('.settings-panel-view').forEach(p=>p.style.display='none');
            document.getElementById('panel-'+btn.dataset.panel).style.display='block';
          });
        });

        /* ============ FILTER CHIPS ============ */
        document.querySelectorAll('.filter-chips').forEach(group=>{
          group.querySelectorAll('.f-chip').forEach(chip=>{
            chip.addEventListener('click',()=>{
              group.querySelectorAll('.f-chip').forEach(c=>c.classList.remove('active'));
              chip.classList.add('active');
            });
          });
        });

        /* ============ MODALS ============ */
        function openModal(id,title){
          if(title) document.getElementById('simpleModalTitle').textContent = title;
          document.getElementById(id).classList.add('open');
        }
        function closeModal(id){ document.getElementById(id).classList.remove('open'); }
        function saveAndToast(id,msg){
          closeModal(id);
          const wrap=document.getElementById('toastWrap');
          const t=document.createElement('div');
          t.className='toast';
          t.innerHTML = '<span class="ic">✓</span> '+msg;
          wrap.appendChild(t);
          setTimeout(()=>t.remove(),3400);
        }
        document.querySelectorAll('.modal-overlay').forEach(ov=>{
          ov.addEventListener('click',e=>{ if(e.target===ov) ov.classList.remove('open'); });
        });

        /* ============ DATA ============ */
        const events = [
          {title:'Aurora Fest 2026',cat:'Konser',city:'İstanbul',date:'18 Ağu 2026',org:'NovaEvents',fill:82,status:'live'},
          {title:'Şampiyonlar Ligi Finali',cat:'Spor',city:'İstanbul',date:'02 Eyl 2026',org:'ArenaLive',fill:96,status:'live'},
          {title:'Gölgede Kalan Şehir',cat:'Tiyatro',city:'Ankara',date:'24 Ağu 2026',org:'Sahne7',fill:45,status:'pending'},
          {title:'Kıyı Elektronik Festival',cat:'Festival',city:'İzmir',date:'12 Eyl 2026',org:'PulseCollective',fill:70,status:'live'},
          {title:'Gece Yarısı Kahkaha',cat:'Stand-up',city:'İstanbul',date:'05 Eyl 2026',org:'GülBir',fill:58,status:'draft'},
          {title:'Akustik Gece: Bosphorus',cat:'Konser',city:'İstanbul',date:'29 Ağu 2026',org:'Meridyen Prod.',fill:38,status:'ended'},
        ];
        const statusMap = {live:['Yayında','green'],pending:['Onay Bekliyor','orange'],draft:['Taslak','gray'],ended:['Sona Erdi','red']};

        function fillBar(pct){ return `<span class="mini-bar"><i style="width:${pct}%"></i></span>${pct}%`; }
        function statusBadge(s){ const [label,color]=statusMap[s]; return `<span class="badge ${color}">${label}</span>`; }

        document.getElementById('eventsBody').innerHTML = events.map(e=>`
          <tr>
            <td><div class="cell-main"><div class="cell-avatar"></div><div><div class="cell-title">${e.title}</div><div class="cell-sub">${e.date}</div></div></div></td>
            <td>${e.cat}</td>
            <td>${e.city}</td>
            <td>${e.org}</td>
            <td>${fillBar(e.fill)}</td>
            <td>${statusBadge(e.status)}</td>
            <td><div class="row-actions"><button class="btn-icon-only" title="Görüntüle">👁</button><button class="btn-icon-only" title="Düzenle" onclick="openModal('eventModal')">✎</button><button class="btn-icon-only" title="Sil" onclick="openModal('confirmModal')" style="color:var(--danger);">🗑</button></div></td>
          </tr>`).join('');

        document.getElementById('topEventsBody').innerHTML = events.slice(0,5).map(e=>`
          <tr>
            <td><div class="cell-main"><div class="cell-avatar"></div><div class="cell-title">${e.title}</div></div></td>
            <td>${e.city}</td>
            <td>${Math.floor(e.fill*38)}</td>
            <td>${fillBar(e.fill)}</td>
            <td><b style="font-family:var(--font-mono);font-size:12.5px;">₺${(e.fill*4210).toLocaleString('tr-TR')}</b></td>
          </tr>`).join('');

        const categories = [
          {ic:'🎵',name:'Konser',count:'1.240 etkinlik'},{ic:'🎭',name:'Tiyatro',count:'560 etkinlik'},
          {ic:'⚽',name:'Spor',count:'890 etkinlik'},{ic:'🎪',name:'Festival',count:'320 etkinlik'},
          {ic:'🎤',name:'Stand-up',count:'410 etkinlik'},{ic:'👨‍👩‍👧',name:'Aile',count:'275 etkinlik'},
          {ic:'🎬',name:'Sinema',count:'190 etkinlik'},{ic:'🎨',name:'Sanat',count:'140 etkinlik'},
        ];
        document.getElementById('categoriesGrid').innerHTML = categories.map(c=>`
          <div class="manage-tile"><span class="tile-menu">⋮</span><div class="ic">${c.ic}</div><h4>${c.name}</h4><span>${c.count}</span></div>`).join('')
          + `<div class="manage-tile add-tile" onclick="openModal('simpleModal','Yeni Kategori')"><div style="font-size:22px;">+</div><span>Yeni Kategori</span></div>`;

        const cities = [
          {ic:'🏙️',name:'İstanbul',count:'4.200+ etkinlik'},{ic:'🏛️',name:'Ankara',count:'1.100+ etkinlik'},
          {ic:'🌊',name:'İzmir',count:'890+ etkinlik'},{ic:'🏖️',name:'Antalya',count:'640+ etkinlik'},
          {ic:'🌳',name:'Bursa',count:'510+ etkinlik'},{ic:'🌶️',name:'Adana',count:'330+ etkinlik'},
        ];
        document.getElementById('citiesGrid').innerHTML = cities.map(c=>`
          <div class="manage-tile"><span class="tile-menu">⋮</span><div class="ic">${c.ic}</div><h4>${c.name}</h4><span>${c.count}</span></div>`).join('')
          + `<div class="manage-tile add-tile" onclick="openModal('simpleModal','Yeni Şehir')"><div style="font-size:22px;">+</div><span>Yeni Şehir</span></div>`;

        const sponsors = [
          {n:'NovaWave'},{n:'Orbitel'},{n:'Kentro'},{n:'Fluxbank'},{n:'Solace'},{n:'Meridyen'},
        ];
        document.getElementById('sponsorsGrid').innerHTML = sponsors.map(s=>`
          <div class="manage-tile"><span class="tile-menu">⋮</span><div class="ic" style="border-radius:50%;">${s.n.slice(0,2).toUpperCase()}</div><h4>${s.n}</h4><span>Aktif sponsor</span></div>`).join('')
          + `<div class="manage-tile add-tile" onclick="openModal('simpleModal','Yeni Sponsor')"><div style="font-size:22px;">+</div><span>Yeni Sponsor</span></div>`;

        const blogs = [
          {t:'2026 sonbaharının en çok konuşulan 10 festivali',tag:'Rehber',author:'Ece Yıldız',date:'12 Tem 2026',status:'live'},
          {t:'Bir konser nasıl sahneleniyor? Perde arkası',tag:'Kulis',author:'Onur Kaya',date:'04 Tem 2026',status:'live'},
          {t:'En uygun bilet fiyatını yakalamanın 5 yolu',tag:'İpucu',author:'Ece Yıldız',date:'28 Haz 2026',status:'draft'},
        ];
        document.getElementById('blogBody').innerHTML = blogs.map(b=>`
          <tr><td><div class="cell-title">${b.t}</div></td><td>${b.tag}</td><td>${b.author}</td><td>${b.date}</td><td>${statusBadge(b.status==='live'?'live':'draft')}</td>
          <td><div class="row-actions"><button class="btn-icon-only">✎</button><button class="btn-icon-only" style="color:var(--danger);" onclick="openModal('confirmModal')">🗑</button></div></td></tr>`).join('');

        const reviews = [
          {name:'Kerem S.',city:'İstanbul',stars:2,text:'Etkinlik iptal oldu ama iade süreci çok yavaş işledi.',flag:true},
          {name:'Aslı D.',city:'İzmir',stars:5,text:'Muhteşem bir organizasyondu, her şey zamanında ilerledi.',flag:false},
          {name:'Uğur B.',city:'Ankara',stars:1,text:'Bu yorum uygunsuz içerik nedeniyle şikayet edildi.',flag:true},
          {name:'Nazlı P.',city:'Bursa',stars:4,text:'Bilet alma deneyimi çok akıcıydı, tavsiye ederim.',flag:false},
        ];
        document.getElementById('reviewList').innerHTML = reviews.map(r=>`
          <div class="review-item">
            <div class="review-top"><div class="av"></div><div><b>${r.name}</b> <span>· ${r.city}</span></div><div class="review-stars">${'★'.repeat(r.stars)}${'☆'.repeat(5-r.stars)}</div>${r.flag?'<span class="review-flag">Şikayet</span>':''}</div>
            <p>${r.text}</p>
            <div class="row-actions" style="justify-content:flex-start;"><button class="btn btn-sm btn-ghost">Onayla</button><button class="btn btn-sm btn-danger" onclick="openModal('confirmModal')">Kaldır</button></div>
          </div>`).join('');

        const orgApprovals = [
          {n:'StageWorks Prod.',c:'İstanbul',t:'3 gün önce başvurdu'},
          {n:'Anadolu Etkinlik',c:'Ankara',t:'1 gün önce başvurdu'},
          {n:'Ege Sahne',c:'İzmir',t:'5 saat önce başvurdu'},
        ];
        document.getElementById('approveList').innerHTML = orgApprovals.map(o=>`
          <div class="approve-card"><div class="cell-avatar"></div><div class="info"><h4>${o.n}</h4><span>${o.c} · ${o.t}</span></div>
          <div class="approve-actions"><button class="btn btn-sm btn-primary">Onayla</button><button class="btn btn-sm btn-danger" onclick="openModal('confirmModal')">Reddet</button></div></div>`).join('');

        const orgsMini = [
          {n:'NovaEvents',c:'1.2K etkinlik',v:true},{n:'ArenaLive',c:'860 etkinlik',v:true},
          {n:'Sahne7',c:'410 etkinlik',v:false},{n:'PulseCollective',c:'320 etkinlik',v:true},
        ];
        document.getElementById('orgMiniList').innerHTML = orgsMini.map(o=>`
          <div class="approve-card"><div class="cell-avatar"></div><div class="info"><h4>${o.n} ${o.v?'<span style="color:var(--accent);">✓</span>':''}</h4><span>${o.c}</span></div>
          <label class="switch"><input type="checkbox" ${o.v?'checked':''}><span class="track"></span></label></div>`).join('');

        const users = [
          {n:'Elif Kaya',e:'elif.kaya@mail.com',role:'Kullanıcı',date:'12 Oca 2026',orders:14,status:'active'},
          {n:'Baran Turan',e:'baran.t@mail.com',role:'Kullanıcı',date:'03 Mar 2026',orders:6,status:'active'},
          {n:'Deniz Arslan',e:'deniz.a@mail.com',role:'Organizatör',date:'22 Şub 2026',orders:0,status:'active'},
          {n:'Kerem Sancak',e:'kerem.s@mail.com',role:'Kullanıcı',date:'15 Nis 2026',orders:2,status:'suspended'},
          {n:'Aslı Demir',e:'asli.d@mail.com',role:'Kullanıcı',date:'29 May 2026',orders:9,status:'active'},
          {n:'Uğur Baş',e:'ugur.b@mail.com',role:'Kullanıcı',date:'07 Haz 2026',orders:1,status:'banned'},
          {n:'Nazlı Polat',e:'nazli.p@mail.com',role:'Editör',date:'19 Tem 2026',orders:0,status:'active'},
        ];
        const userStatusMap = {active:['Aktif','green'],suspended:['Askıda','orange'],banned:['Yasaklı','red']};
        document.getElementById('usersBody').innerHTML = users.map(u=>{
          const [label,color]=userStatusMap[u.status];
          return `<tr><td><div class="cell-main"><div class="cell-avatar round"></div><div><div class="cell-title">${u.n}</div><div class="cell-sub">${u.e}</div></div></div></td>
          <td><span class="badge blue">${u.role}</span></td><td>${u.date}</td><td>${u.orders}</td><td><span class="badge ${color}">${label}</span></td>
          <td><div class="row-actions"><button class="btn-icon-only">👁</button><button class="btn-icon-only">✎</button><button class="btn-icon-only" style="color:var(--danger);" onclick="openModal('confirmModal')">⛔</button></div></td></tr>`;
        }).join('');

        const orders = [
          {no:'#TB-88213',user:'Elif Kaya',event:'Aurora Fest 2026',amount:'₺900',date:'21 Tem 2026',status:'paid'},
          {no:'#TB-88214',user:'Baran Turan',event:'Şampiyonlar Ligi Finali',amount:'₺1.960',date:'21 Tem 2026',status:'paid'},
          {no:'#TB-88190',user:'Kerem Sancak',event:'Gölgede Kalan Şehir',amount:'₺440',date:'19 Tem 2026',status:'refunded'},
          {no:'#TB-88175',user:'Nazlı Polat',event:'Kıyı Elektronik Festival',amount:'₺650',date:'18 Tem 2026',status:'cancelled'},
          {no:'#TB-88160',user:'Aslı Demir',event:'Gece Yarısı Kahkaha',amount:'₺310',date:'17 Tem 2026',status:'paid'},
        ];
        const orderStatusMap = {paid:['Ödendi','green'],refunded:['İade Edildi','orange'],cancelled:['İptal','red']};
        document.getElementById('ordersBody').innerHTML = orders.map(o=>{
          const [label,color]=orderStatusMap[o.status];
          return `<tr><td style="font-family:var(--font-mono);">${o.no}</td><td>${o.user}</td><td>${o.event}</td><td><b>${o.amount}</b></td><td>${o.date}</td><td><span class="badge ${color}">${label}</span></td>
          <td><div class="row-actions"><button class="btn-icon-only">👁</button><button class="btn-icon-only" title="İade" onclick="openModal('confirmModal')">↩</button></div></td></tr>`;
        }).join('');

        const payouts = [
          {n:'NovaEvents',period:'Temmuz 2026',gross:'₺820.000',fee:'₺82.000',net:'₺738.000',status:'pending'},
          {n:'ArenaLive',period:'Temmuz 2026',gross:'₺1.240.000',fee:'₺124.000',net:'₺1.116.000',status:'paid'},
          {n:'PulseCollective',period:'Temmuz 2026',gross:'₺410.000',fee:'₺41.000',net:'₺369.000',status:'pending'},
        ];
        document.getElementById('payoutBody').innerHTML = payouts.map(p=>`
          <tr><td><div class="cell-main"><div class="cell-avatar"></div>${p.n}</div></td><td>${p.period}</td><td>${p.gross}</td><td>${p.fee}</td><td><b>${p.net}</b></td>
          <td>${p.status==='paid'?'<span class="badge green">Ödendi</span>':'<span class="badge orange">Bekliyor</span>'}</td>
          <td><div class="row-actions">${p.status==='pending'?'<button class="btn btn-sm btn-primary">Ödemeyi Onayla</button>':'<button class="btn-icon-only">👁</button>'}</div></td></tr>`).join('');

        const notifs = [
          {ic:'🎟️',c:'primary',t:'Yeni etkinlik onay bekliyor',s:'"Gölgede Kalan Şehir" incelemenizi bekliyor',time:'5 dk önce'},
          {ic:'🏷️',c:'accent',t:'Yeni organizatör başvurusu',s:'Ege Sahne platforma katılmak için başvurdu',time:'2 saat önce'},
          {ic:'⚑',c:'danger',t:'Yorum şikayeti alındı',s:'Bir kullanıcı yorumu uygunsuz içerik olarak işaretledi',time:'4 saat önce'},
          {ic:'💳',c:'warn',t:'Ödeme kuyruğunda bekleyen tutar',s:'2 organizatör ödemesi onay bekliyor',time:'1 gün önce'},
          {ic:'👤',c:'secondary',t:'Kullanıcı şikayeti',s:'Bir sipariş için iade talebi oluşturuldu',time:'1 gün önce'},
          {ic:'📈',c:'accent',t:'Haftalık rapor hazır',s:'Bu haftaki performans özeti oluşturuldu',time:'2 gün önce'},
        ];
        document.getElementById('notifList').innerHTML = notifs.map(n=>`
          <div class="feed-item"><div class="feed-ic" style="background:rgba(var(--${n.c}-rgb,124,92,255),.14);color:var(--${n.c==='warn'?'warn':n.c});">${n.ic}</div>
          <div><p><b>${n.t}</b></p><p>${n.s}</p><span>${n.time}</span></div></div>`).join('');

        document.getElementById('activityFeed').innerHTML = [
          {ic:'🎟️',c:'primary',txt:'<b>Aurora Fest 2026</b> için 42 yeni bilet satıldı',time:'12 dk önce'},
          {ic:'✓',c:'accent',txt:'<b>StageWorks Prod.</b> organizatör onayı verildi',time:'38 dk önce'},
          {ic:'💳',c:'secondary',txt:'<b>ArenaLive</b> ödemesi başarıyla gerçekleşti',time:'1 saat önce'},
          {ic:'⚑',c:'danger',txt:'Bir yorum şikayet nedeniyle incelemeye alındı',time:'3 saat önce'},
          {ic:'📝',c:'warn',txt:'Yeni blog yazısı yayınlandı: "En uygun bilet fiyatı"',time:'6 saat önce'},
        ].map(a=>`<div class="feed-item"><div class="feed-ic" style="background:rgba(var(--${a.c}-rgb),.14);color:var(--${a.c});">${a.ic}</div><div><p>${a.txt}</p><span>${a.time}</span></div></div>`).join('');

        /* ============ COUNTERS ============ */
        function animateCounter(el,target,prefix){
          let start=performance.now(), dur=1400;
          function tick(now){
            const p=Math.min((now-start)/dur,1), eased=1-Math.pow(1-p,3);
            const cur=Math.floor(eased*target);
            el.textContent=(prefix||'')+cur.toLocaleString('tr-TR');
            if(p<1) requestAnimationFrame(tick); else el.textContent=(prefix||'')+target.toLocaleString('tr-TR');
          }
          requestAnimationFrame(tick);
        }
        document.querySelectorAll('.counter').forEach(el=>animateCounter(el,+el.dataset.target,el.dataset.prefix));

        /* ============ CHARTS ============ */
        function cssVar(name){ return getComputedStyle(document.body).getPropertyValue(name).trim(); }
        let revenueChart, categoryChart;
        function buildCharts(){
          const ctx1=document.getElementById('revenueChart').getContext('2d');
          const grad=ctx1.createLinearGradient(0,0,0,220);
          grad.addColorStop(0, 'rgba('+cssVar('--primary-rgb')+',.35)');
          grad.addColorStop(1, 'rgba('+cssVar('--primary-rgb')+',0)');
          revenueChart = new Chart(ctx1,{
            type:'line',
            data:{labels:['Ağu','Eyl','Eki','Kas','Ara','Oca','Şub','Mar','Nis','May','Haz','Tem'],
              datasets:[{label:'Gelir',data:[2.1,2.4,2.2,2.8,3.4,3.1,3.6,3.9,4.0,4.3,4.5,4.82],borderColor:cssVar('--primary'),backgroundColor:grad,fill:true,tension:.4,pointRadius:0,borderWidth:2.5}]},
            options:{plugins:{legend:{display:false}},scales:{x:{grid:{display:false},ticks:{color:cssVar('--subtitle'),font:{size:11}}},y:{grid:{color:cssVar('--border')},ticks:{color:cssVar('--subtitle'),font:{size:11},callback:v=>'₺'+v+'M'}}}}
          });
          const ctx2=document.getElementById('categoryChart').getContext('2d');
          const catColors=[cssVar('--primary'),cssVar('--secondary'),cssVar('--accent'),cssVar('--warn') || '#FFB454', cssVar('--danger')];
          categoryChart = new Chart(ctx2,{
            type:'doughnut',
            data:{labels:['Konser','Spor','Festival','Tiyatro','Diğer'],datasets:[{data:[38,24,18,12,8],backgroundColor:catColors,borderWidth:0}]},
            options:{cutout:'68%',plugins:{legend:{display:false}}}
          });
          document.getElementById('catLegend').innerHTML = ['Konser','Spor','Festival','Tiyatro','Diğer'].map((l,i)=>`<div class="legend-item"><i style="background:${catColors[i]}"></i>${l}</div>`).join('');
        }
        function refreshCharts(){
          if(!revenueChart) return;
          const grad=revenueChart.ctx.createLinearGradient(0,0,0,220);
          grad.addColorStop(0,'rgba('+cssVar('--primary-rgb')+',.35)'); grad.addColorStop(1,'rgba('+cssVar('--primary-rgb')+',0)');
          revenueChart.data.datasets[0].borderColor=cssVar('--primary'); revenueChart.data.datasets[0].backgroundColor=grad;
          revenueChart.options.scales.x.ticks.color=cssVar('--subtitle'); revenueChart.options.scales.y.ticks.color=cssVar('--subtitle'); revenueChart.options.scales.y.grid.color=cssVar('--border');
          revenueChart.update();
          categoryChart.data.datasets[0].backgroundColor=[cssVar('--primary'),cssVar('--secondary'),cssVar('--accent'),cssVar('--warn'),cssVar('--danger')];
          categoryChart.update();
          document.getElementById('catLegend').innerHTML = ['Konser','Spor','Festival','Tiyatro','Diğer'].map((l,i)=>`<div class="legend-item"><i style="background:${categoryChart.data.datasets[0].backgroundColor[i]}"></i>${l}</div>`).join('');
        }
        window.addEventListener('load', buildCharts);
    </script>
</body>
</html>