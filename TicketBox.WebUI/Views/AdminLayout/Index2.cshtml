
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TicketBox Admin — Yönetim Paneli</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.0/chart.umd.min.js"></script>
    <style>

        /* ============ DESIGN TOKENS (same system as main site) ============ */
        :root {
            --bg: #0F1117;
            --bg2: #171A22;
            --card: #1D2130;
            --card2: #242939;
            --border: rgba(255,255,255,.06);
            --border-strong: rgba(255,255,255,.12);
            --primary: #7C5CFF;
            --secondary: #4F8CFF;
            --accent: #00D4A4;
            --danger: #FF4D6D;
            --warn: #FFB454;
            --text: #F5F7FA;
            --subtitle: #B8C1D1;
            --primary-rgb: 124,92,255;
            --secondary-rgb: 79,140,255;
            --accent-rgb: 0,212,164;
            --danger-rgb: 255,77,109;
            --warn-rgb: 255,180,84;
            --grad-brand: linear-gradient(135deg,var(--primary),var(--secondary));
            --shadow-lift: 0 20px 60px -15px rgba(0,0,0,.55);
            --radius-xl: 24px;
            --radius-lg: 18px;
            --radius-md: 14px;
            --radius-sm: 10px;
            --font-display: 'Space Grotesk', sans-serif;
            --font-body: 'Inter', sans-serif;
            --font-mono: 'JetBrains Mono', monospace;
            --sidebar-w: 260px;
        }

        [data-theme="aurora"] {
            --bg: #0B1420;
            --bg2: #10192A;
            --card: #142033;
            --card2: #1B2A42;
            --border: rgba(255,255,255,.07);
            --border-strong: rgba(255,255,255,.14);
            --primary: #34D8C7;
            --secondary: #6C5CE7;
            --accent: #7CF29C;
            --danger: #FF6B6B;
            --text: #F2FBFA;
            --subtitle: #A9C6C0;
            --primary-rgb: 52,216,199;
            --secondary-rgb: 108,92,231;
            --accent-rgb: 124,242,156;
        }

        [data-theme="purple"] {
            --bg: #120B1F;
            --bg2: #1A1029;
            --card: #221733;
            --card2: #2B1F40;
            --border: rgba(255,255,255,.07);
            --border-strong: rgba(255,255,255,.14);
            --primary: #A855F7;
            --secondary: #EC4899;
            --accent: #C084FC;
            --danger: #FB7185;
            --text: #F6F3FC;
            --subtitle: #C4B5D6;
            --primary-rgb: 168,85,247;
            --secondary-rgb: 236,72,153;
            --accent-rgb: 192,132,252;
        }

        [data-theme="ocean"] {
            --bg: #081420;
            --bg2: #0D1E2E;
            --card: #12293C;
            --card2: #183651;
            --border: rgba(255,255,255,.06);
            --border-strong: rgba(255,255,255,.13);
            --primary: #2DA8FF;
            --secondary: #00C2D1;
            --accent: #4CE0B3;
            --danger: #FF5D73;
            --text: #EFF7FB;
            --subtitle: #9FC0D1;
            --primary-rgb: 45,168,255;
            --secondary-rgb: 0,194,209;
            --accent-rgb: 76,224,179;
        }

        [data-theme="graphite"] {
            --bg: #15161A;
            --bg2: #1B1D22;
            --card: #212328;
            --card2: #282B32;
            --border: rgba(255,255,255,.06);
            --border-strong: rgba(255,255,255,.12);
            --primary: #9CA3AF;
            --secondary: #6B7280;
            --accent: #34D399;
            --danger: #F87171;
            --text: #F3F4F6;
            --subtitle: #A1A6AD;
            --primary-rgb: 156,163,175;
            --secondary-rgb: 107,114,128;
            --accent-rgb: 52,211,153;
        }

        [data-theme="light"] {
            --bg: #F3F4F8;
            --bg2: #FFFFFF;
            --card: #FFFFFF;
            --card2: #F1F2F8;
            --border: rgba(15,17,23,.08);
            --border-strong: rgba(15,17,23,.16);
            --primary: #7C5CFF;
            --secondary: #4F8CFF;
            --accent: #00B894;
            --danger: #E0455A;
            --text: #14161C;
            --subtitle: #5B6472;
            --primary-rgb: 124,92,255;
            --secondary-rgb: 79,140,255;
            --accent-rgb: 0,184,148;
            --shadow-lift: 0 20px 60px -15px rgba(20,22,28,.15);
        }

        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background: var(--bg);
            color: var(--text);
            font-family: var(--font-body);
            -webkit-font-smoothing: antialiased;
            transition: background .3s ease,color .3s ease;
        }

        img {
            max-width: 100%;
            display: block;
        }

        a {
            color: inherit;
            text-decoration: none;
        }

        button {
            font-family: inherit;
            cursor: pointer;
            border: none;
            background: none;
            color: inherit;
        }

        ul {
            list-style: none;
        }

        h1, h2, h3, h4 {
            font-family: var(--font-display);
            line-height: 1.15;
            letter-spacing: -0.01em;
        }

        input, select, textarea {
            font-family: inherit;
            color: var(--text);
        }

        :focus-visible {
            outline: 2px solid var(--accent);
            outline-offset: 2px;
        }

        .glass {
            background: rgba(255,255,255,.03);
            border: 1px solid var(--border);
            backdrop-filter: blur(20px);
        }

        [data-theme="light"] .glass {
            background: rgba(255,255,255,.7);
        }

        /* ============ LAYOUT ============ */
        .admin-shell {
            display: flex;
            min-height: 100vh;
        }

        /* ---- sidebar ---- */
        .sidebar {
            width: var(--sidebar-w);
            flex-shrink: 0;
            position: fixed;
            top: 0;
            left: 0;
            bottom: 0;
            z-index: 50;
            background: var(--bg2);
            border-right: 1px solid var(--border);
            display: flex;
            flex-direction: column;
            transition: transform .35s cubic-bezier(.2,.8,.2,1), width .3s ease;
        }

        .sidebar-head {
            padding: 22px 20px;
            display: flex;
            align-items: center;
            gap: 10px;
            border-bottom: 1px solid var(--border);
        }

        .logo-mark {
            width: 34px;
            height: 34px;
            border-radius: 10px;
            background: var(--grad-brand);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-family: var(--font-display);
            font-weight: 700;
            font-size: 15px;
            flex-shrink: 0;
            box-shadow: 0 6px 18px -4px rgba(var(--primary-rgb),.6);
        }

        .logo-text {
            font-family: var(--font-display);
            font-weight: 700;
            font-size: 16.5px;
        }

            .logo-text span {
                display: block;
                font-family: var(--font-mono);
                font-size: 10px;
                font-weight: 400;
                color: var(--subtitle);
                letter-spacing: .08em;
            }

        .nav-scroll {
            flex: 1;
            overflow-y: auto;
            padding: 16px 12px;
            scrollbar-width: none;
            -ms-overflow-style: none;
        }

            .nav-scroll::-webkit-scrollbar {
                display: none;
            }

        .nav-group {
            margin-bottom: 22px;
        }

        .nav-group-label {
            font-size: 10.5px;
            text-transform: uppercase;
            letter-spacing: .1em;
            color: var(--subtitle);
            padding: 0 12px;
            margin-bottom: 8px;
            font-weight: 600;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 11px 12px;
            border-radius: 12px;
            font-size: 14px;
            font-weight: 500;
            color: var(--subtitle);
            margin-bottom: 2px;
            position: relative;
            transition: .2s;
            width: 100%;
            text-align: left;
        }

            .nav-item .ic {
                width: 20px;
                text-align: center;
                font-size: 15px;
                flex-shrink: 0;
            }

            .nav-item .badge {
                margin-left: auto;
                font-size: 10.5px;
                font-family: var(--font-mono);
                background: rgba(var(--danger-rgb),.15);
                color: var(--danger);
                padding: 2px 7px;
                border-radius: 100px;
            }

            .nav-item:hover {
                background: rgba(255,255,255,.05);
                color: var(--text);
            }

            .nav-item.active {
                background: linear-gradient(90deg,rgba(var(--primary-rgb),.16),rgba(var(--primary-rgb),.02));
                color: var(--text);
            }

                .nav-item.active::before {
                    content: '';
                    position: absolute;
                    left: 0;
                    top: 8px;
                    bottom: 8px;
                    width: 3px;
                    border-radius: 100px;
                    background: var(--grad-brand);
                }

        .sidebar-foot {
            padding: 16px;
            border-top: 1px solid var(--border);
        }

        .admin-mini {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px;
            border-radius: 12px;
            background: rgba(255,255,255,.03);
        }

            .admin-mini .av {
                width: 34px;
                height: 34px;
                border-radius: 50%;
                background: var(--grad-brand);
                flex-shrink: 0;
            }

            .admin-mini b {
                font-size: 13px;
                display: block;
            }

            .admin-mini span {
                font-size: 11px;
                color: var(--subtitle);
            }

        /* ---- main ---- */
        .main {
            flex: 1;
            margin-left: var(--sidebar-w);
            min-width: 0;
        }

        .topbar {
            position: sticky;
            top: 0;
            z-index: 40;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 16px 28px;
            border-bottom: 1px solid var(--border);
            background: rgba(15,17,23,.7);
            backdrop-filter: blur(16px);
        }

        [data-theme="light"] .topbar {
            background: rgba(255,255,255,.75);
        }

        .topbar-left {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .menu-toggle {
            display: none;
            width: 38px;
            height: 38px;
            border-radius: 10px;
            border: 1px solid var(--border-strong);
            align-items: center;
            justify-content: center;
        }

        .page-title {
            font-size: 19px;
        }

        .page-sub {
            font-size: 12.5px;
            color: var(--subtitle);
            margin-top: 1px;
        }

        .search-box {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 9px 16px;
            border-radius: 100px;
            border: 1px solid var(--border-strong);
            background: rgba(255,255,255,.03);
            width: 280px;
        }

            .search-box input {
                background: none;
                border: none;
                outline: none;
                font-size: 13.5px;
                width: 100%;
                color: var(--text);
            }

                .search-box input::placeholder {
                    color: var(--subtitle);
                }

        .topbar-right {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .icon-btn {
            width: 38px;
            height: 38px;
            border-radius: 10px;
            border: 1px solid var(--border-strong);
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            transition: .2s;
        }

            .icon-btn:hover {
                background: rgba(255,255,255,.06);
            }

            .icon-btn .dot {
                position: absolute;
                top: 7px;
                right: 7px;
                width: 7px;
                height: 7px;
                border-radius: 50%;
                background: var(--danger);
            }

        .theme-switch {
            position: relative;
        }

        .theme-btn {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 8px 12px;
            border-radius: 100px;
            border: 1px solid var(--border-strong);
            background: rgba(255,255,255,.03);
            font-size: 13px;
        }

        .theme-dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: var(--grad-brand);
        }

        .theme-menu {
            position: absolute;
            top: calc(100% + 10px);
            right: 0;
            width: 190px;
            padding: 8px;
            border-radius: var(--radius-md);
            opacity: 0;
            visibility: hidden;
            transform: translateY(-8px) scale(.97);
            transition: .25s cubic-bezier(.2,.8,.2,1);
            box-shadow: var(--shadow-lift);
            background: rgba(20,22,30,.9);
            backdrop-filter: blur(20px);
            border: 1px solid var(--border-strong);
            z-index: 60;
        }

        [data-theme="light"] .theme-menu {
            background: rgba(255,255,255,.95);
        }

        .theme-switch.open .theme-menu {
            opacity: 1;
            visibility: visible;
            transform: translateY(0) scale(1);
        }

        .theme-opt {
            display: flex;
            align-items: center;
            gap: 9px;
            width: 100%;
            padding: 9px 11px;
            border-radius: 9px;
            font-size: 13px;
        }

            .theme-opt:hover {
                background: rgba(255,255,255,.06);
            }

            .theme-opt.active {
                background: rgba(var(--primary-rgb),.12);
                color: var(--primary);
            }

            .theme-opt .sw {
                width: 14px;
                height: 14px;
                border-radius: 5px;
                flex-shrink: 0;
            }

        .content {
            padding: 28px;
        }

        .view {
            display: none;
        }

            .view.active {
                display: block;
                animation: fadein .35s ease;
            }

        @@keyframes fadein {
            from {
                opacity: 0;
                transform: translateY(6px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@keyframes pulseGlow {
            0%, 100% {
                opacity: .5;
            }

            50% {
                opacity: 1;
            }
        }

        @@keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }

        @@keyframes slideUp {
            from {
                opacity: 0;
                transform: translateY(24px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* ============ SHARED COMPONENTS ============ */
        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            padding: 10px 18px;
            border-radius: 11px;
            font-size: 13.5px;
            font-weight: 600;
            transition: .2s;
            white-space: nowrap;
        }

        .btn-primary {
            background: var(--grad-brand);
            color: #fff;
            box-shadow: 0 8px 22px -8px rgba(var(--primary-rgb),.55);
        }

            .btn-primary:hover {
                transform: translateY(-2px);
                box-shadow: 0 12px 28px -8px rgba(var(--primary-rgb),.7);
            }

        .btn-ghost {
            background: rgba(255,255,255,.03);
            border: 1px solid var(--border-strong);
        }

            .btn-ghost:hover {
                background: rgba(255,255,255,.07);
            }

        .btn-danger {
            background: rgba(var(--danger-rgb),.12);
            color: var(--danger);
            border: 1px solid rgba(var(--danger-rgb),.3);
        }

            .btn-danger:hover {
                background: rgba(var(--danger-rgb),.2);
            }

        .btn-sm {
            padding: 7px 13px;
            font-size: 12.5px;
            border-radius: 9px;
        }

        .btn-icon-only {
            width: 34px;
            height: 34px;
            padding: 0;
            border-radius: 9px;
            border: 1px solid var(--border-strong);
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

            .btn-icon-only:hover {
                background: rgba(255,255,255,.06);
            }

        .card {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            padding: 22px;
        }

        .view-head {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 24px;
            flex-wrap: wrap;
            gap: 14px;
        }

            .view-head h2 {
                font-size: 24px;
                margin-bottom: 4px;
            }

            .view-head p {
                color: var(--subtitle);
                font-size: 13.5px;
            }

        .head-actions {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }

        /* stat cards */
        .stat-row {
            display: grid;
            grid-template-columns: repeat(4,1fr);
            gap: 18px;
            margin-bottom: 24px;
        }

        .stat-card {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            padding: 20px;
            position: relative;
            overflow: hidden;
        }

            .stat-card .top {
                display: flex;
                justify-content: space-between;
                align-items: flex-start;
                margin-bottom: 14px;
            }

        .stat-ic {
            width: 38px;
            height: 38px;
            border-radius: 11px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 17px;
        }

        .stat-card b {
            font-family: var(--font-display);
            font-size: 26px;
            display: block;
        }

        .stat-card .lbl {
            font-size: 12.5px;
            color: var(--subtitle);
            margin-top: 2px;
        }

        .trend {
            font-size: 11.5px;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 3px;
            padding: 4px 8px;
            border-radius: 100px;
        }

            .trend.up {
                color: var(--accent);
                background: rgba(var(--accent-rgb),.12);
            }

            .trend.down {
                color: var(--danger);
                background: rgba(var(--danger-rgb),.12);
            }

        /* charts row */
        .chart-row {
            display: grid;
            grid-template-columns: 1.6fr 1fr;
            gap: 18px;
            margin-bottom: 24px;
        }

        .chart-card h3 {
            font-size: 15.5px;
            margin-bottom: 2px;
        }

        .chart-card .sub {
            font-size: 12px;
            color: var(--subtitle);
            margin-bottom: 16px;
        }

        .legend-row {
            display: flex;
            gap: 16px;
            margin-top: 14px;
            flex-wrap: wrap;
        }

        .legend-item {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 12px;
            color: var(--subtitle);
        }

            .legend-item i {
                width: 9px;
                height: 9px;
                border-radius: 3px;
                display: inline-block;
            }

        .two-col {
            display: grid;
            grid-template-columns: 1.5fr 1fr;
            gap: 18px;
        }

        /* table */
        .table-card {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            overflow: hidden;
        }

        .table-toolbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 18px 20px;
            border-bottom: 1px solid var(--border);
            flex-wrap: wrap;
            gap: 12px;
        }

        .filter-chips {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }

        .f-chip {
            padding: 7px 14px;
            border-radius: 100px;
            font-size: 12.5px;
            border: 1px solid var(--border-strong);
            color: var(--subtitle);
        }

            .f-chip.active {
                background: var(--grad-brand);
                color: #fff;
                border-color: transparent;
            }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        thead th {
            text-align: left;
            font-size: 11.5px;
            text-transform: uppercase;
            letter-spacing: .06em;
            color: var(--subtitle);
            padding: 12px 20px;
            border-bottom: 1px solid var(--border);
            font-weight: 600;
            white-space: nowrap;
        }

        tbody td {
            padding: 14px 20px;
            font-size: 13.5px;
            border-bottom: 1px solid var(--border);
            white-space: nowrap;
        }

        tbody tr:last-child td {
            border-bottom: none;
        }

        tbody tr {
            transition: background .15s;
        }

            tbody tr:hover {
                background: rgba(255,255,255,.02);
            }

        .cell-main {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .cell-avatar {
            width: 34px;
            height: 34px;
            border-radius: 10px;
            background: var(--grad-brand);
            flex-shrink: 0;
        }

            .cell-avatar.round {
                border-radius: 50%;
            }

        .cell-title {
            font-weight: 600;
            font-size: 13.5px;
        }

        .cell-sub {
            font-size: 11.5px;
            color: var(--subtitle);
        }

        .badge {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 5px 11px;
            border-radius: 100px;
            font-size: 11.5px;
            font-weight: 600;
        }

            .badge.green {
                background: rgba(var(--accent-rgb),.14);
                color: var(--accent);
            }

            .badge.blue {
                background: rgba(var(--secondary-rgb),.16);
                color: var(--secondary);
            }

            .badge.orange {
                background: rgba(255,180,84,.16);
                color: var(--warn);
            }

            .badge.red {
                background: rgba(var(--danger-rgb),.14);
                color: var(--danger);
            }

            .badge.gray {
                background: rgba(255,255,255,.08);
                color: var(--subtitle);
            }

        .row-actions {
            display: flex;
            gap: 6px;
            justify-content: flex-end;
        }

        .table-foot {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 14px 20px;
            font-size: 12.5px;
            color: var(--subtitle);
        }

        .pager {
            display: flex;
            gap: 6px;
        }

            .pager button {
                width: 30px;
                height: 30px;
                border-radius: 8px;
                border: 1px solid var(--border-strong);
                font-size: 12.5px;
            }

                .pager button.active {
                    background: var(--grad-brand);
                    color: #fff;
                    border-color: transparent;
                }

        /* progress mini bar (capacity) */
        .mini-bar {
            width: 70px;
            height: 5px;
            border-radius: 100px;
            background: var(--card2);
            overflow: hidden;
            display: inline-block;
            vertical-align: middle;
            margin-right: 6px;
        }

            .mini-bar i {
                display: block;
                height: 100%;
                background: var(--grad-brand);
            }

        /* activity feed */
        .feed-item {
            display: flex;
            gap: 12px;
            padding: 14px 0;
            border-bottom: 1px solid var(--border);
        }

            .feed-item:last-child {
                border-bottom: none;
            }

        .feed-ic {
            width: 34px;
            height: 34px;
            border-radius: 10px;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 14px;
        }

        .feed-item p {
            font-size: 13px;
            line-height: 1.5;
        }

        .feed-item span {
            font-size: 11.5px;
            color: var(--subtitle);
        }

        .feed-item b {
            font-weight: 600;
        }

        /* pending approval card */
        .approve-card {
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 16px;
            border-radius: var(--radius-md);
            border: 1px solid var(--border);
            margin-bottom: 10px;
        }

            .approve-card:last-child {
                margin-bottom: 0;
            }

            .approve-card .info {
                flex: 1;
                min-width: 0;
            }

            .approve-card h4 {
                font-size: 13.5px;
                margin-bottom: 3px;
            }

            .approve-card span {
                font-size: 11.5px;
                color: var(--subtitle);
            }

        .approve-actions {
            display: flex;
            gap: 8px;
        }

        /* simple grid manage (categories/cities/sponsors) */
        .manage-grid {
            display: grid;
            grid-template-columns: repeat(4,1fr);
            gap: 14px;
        }

        .manage-tile {
            padding: 18px;
            border-radius: var(--radius-md);
            border: 1px solid var(--border);
            background: var(--card);
            position: relative;
            text-align: center;
        }

            .manage-tile .ic {
                width: 44px;
                height: 44px;
                border-radius: 13px;
                background: var(--grad-brand);
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 19px;
                color: #fff;
                margin: 0 auto 10px;
            }

            .manage-tile h4 {
                font-size: 14px;
                margin-bottom: 3px;
            }

            .manage-tile span {
                font-size: 11.5px;
                color: var(--subtitle);
            }

            .manage-tile .tile-menu {
                position: absolute;
                top: 10px;
                right: 10px;
                font-size: 14px;
                color: var(--subtitle);
            }

            .manage-tile.add-tile {
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                border-style: dashed;
                color: var(--subtitle);
                cursor: pointer;
            }

                .manage-tile.add-tile:hover {
                    border-color: var(--primary);
                    color: var(--primary);
                }

        /* toggle switch */
        .switch {
            position: relative;
            width: 40px;
            height: 22px;
            flex-shrink: 0;
        }

            .switch input {
                opacity: 0;
                width: 0;
                height: 0;
            }

            .switch .track {
                position: absolute;
                inset: 0;
                background: var(--card2);
                border-radius: 100px;
                transition: .25s;
                border: 1px solid var(--border-strong);
            }

                .switch .track::before {
                    content: '';
                    position: absolute;
                    width: 16px;
                    height: 16px;
                    left: 2px;
                    top: 2px;
                    background: var(--subtitle);
                    border-radius: 50%;
                    transition: .25s;
                }

            .switch input:checked + .track {
                background: var(--grad-brand);
                border-color: transparent;
            }

                .switch input:checked + .track::before {
                    transform: translateX(18px);
                    background: #fff;
                }

        /* review moderation */
        .review-item {
            padding: 16px;
            border-radius: var(--radius-md);
            border: 1px solid var(--border);
            margin-bottom: 12px;
        }

            .review-item:last-child {
                margin-bottom: 0;
            }

        .review-top {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 8px;
        }

            .review-top .av {
                width: 30px;
                height: 30px;
                border-radius: 50%;
                background: var(--grad-brand);
            }

            .review-top b {
                font-size: 13px;
            }

            .review-top span {
                font-size: 11px;
                color: var(--subtitle);
            }

        .review-stars {
            color: var(--accent);
            font-size: 12px;
            margin-left: auto;
        }

        .review-item p {
            font-size: 13px;
            color: var(--subtitle);
            margin-bottom: 10px;
        }

        .review-flag {
            font-size: 11px;
            color: var(--danger);
            background: rgba(var(--danger-rgb),.1);
            padding: 3px 9px;
            border-radius: 100px;
            margin-left: 8px;
        }

        /* settings form */
        .settings-grid {
            display: grid;
            grid-template-columns: 220px 1fr;
            gap: 0;
        }

        .settings-nav {
            border-right: 1px solid var(--border);
            padding-right: 20px;
        }

            .settings-nav button {
                display: block;
                width: 100%;
                text-align: left;
                padding: 10px 14px;
                border-radius: 10px;
                font-size: 13.5px;
                color: var(--subtitle);
                margin-bottom: 2px;
            }

                .settings-nav button.active {
                    background: rgba(var(--primary-rgb),.12);
                    color: var(--primary);
                }

        .settings-panel {
            padding-left: 26px;
        }

        .f-row {
            margin-bottom: 18px;
        }

            .f-row label {
                display: block;
                font-size: 12.5px;
                color: var(--subtitle);
                margin-bottom: 7px;
                font-weight: 500;
            }

            .f-row input[type=text], .f-row input[type=email], .f-row input[type=number], .f-row select, .f-row textarea {
                width: 100%;
                padding: 11px 14px;
                border-radius: 10px;
                border: 1px solid var(--border-strong);
                background: rgba(255,255,255,.03);
                font-size: 13.5px;
                outline: none;
            }

            .f-row textarea {
                resize: vertical;
                min-height: 80px;
            }

        .role-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 14px 0;
            border-bottom: 1px solid var(--border);
        }

            .role-row:last-child {
                border-bottom: none;
            }

            .role-row h4 {
                font-size: 13.5px;
                margin-bottom: 2px;
            }

            .role-row span {
                font-size: 11.5px;
                color: var(--subtitle);
            }

        /* modal */
        .modal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,.55);
            backdrop-filter: blur(4px);
            z-index: 200;
            display: none;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

            .modal-overlay.open {
                display: flex;
            }

        .modal {
            width: 100%;
            max-width: 520px;
            background: var(--bg2);
            border: 1px solid var(--border-strong);
            border-radius: var(--radius-lg);
            box-shadow: var(--shadow-lift);
            animation: slideUp .3s cubic-bezier(.2,.8,.2,1);
            max-height: 86vh;
            overflow-y: auto;
        }

        .modal-head {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px 22px;
            border-bottom: 1px solid var(--border);
        }

            .modal-head h3 {
                font-size: 16.5px;
            }

        .modal-body {
            padding: 22px;
        }

        .modal-foot {
            display: flex;
            justify-content: flex-end;
            gap: 10px;
            padding: 18px 22px;
            border-top: 1px solid var(--border);
        }

        .toast-wrap {
            position: fixed;
            bottom: 24px;
            right: 24px;
            z-index: 300;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .toast {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 14px 18px;
            border-radius: 12px;
            background: var(--card);
            border: 1px solid var(--border-strong);
            box-shadow: var(--shadow-lift);
            font-size: 13.5px;
            animation: slideUp .3s ease;
        }

            .toast .ic {
                color: var(--accent);
            }

        .empty-hint {
            text-align: center;
            padding: 50px 20px;
            color: var(--subtitle);
            font-size: 13.5px;
        }

        /* ============ RESPONSIVE ============ */
        @@media (max-width:1180px) {
            .stat-row {
                grid-template-columns: repeat(2,1fr);
            }

            .chart-row, .two-col {
                grid-template-columns: 1fr;
            }

            .manage-grid {
                grid-template-columns: repeat(2,1fr);
            }
        }

        @@media (max-width:900px) {
            .sidebar {
                transform: translateX(-100%);
            }

                .sidebar.open {
                    transform: translateX(0);
                }

            .main {
                margin-left: 0;
            }

            .menu-toggle {
                display: flex;
            }

            .search-box {
                display: none;
            }

            .settings-grid {
                grid-template-columns: 1fr;
            }

            .settings-nav {
                border-right: none;
                border-bottom: 1px solid var(--border);
                padding-right: 0;
                padding-bottom: 16px;
                margin-bottom: 16px;
                display: flex;
                gap: 6px;
                overflow-x: auto;
            }

            .settings-panel {
                padding-left: 0;
            }
        }

        @@media (max-width:640px) {
            .stat-row {
                grid-template-columns: 1fr 1fr;
            }

            .manage-grid {
                grid-template-columns: 1fr 1fr;
            }

            .content {
                padding: 18px;
            }

            .topbar {
                padding: 14px 16px;
            }

            table {
                font-size: 12.5px;
            }

            thead th, tbody td {
                padding: 10px 12px;
            }
        }
    </style>
</head>
<body data-theme="midnight">

    <div class="admin-shell">

