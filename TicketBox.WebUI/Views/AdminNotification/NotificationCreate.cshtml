@model CreateNotificationCommand
@{
    ViewData["Title"] = "NotificationCreate";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}
<div class="topbar">
    <div class="topbar-left">
        <button class="menu-toggle" id="menuToggle">☰</button>
        <div>
            <div class="page-title" id="pageTitle">Yeni Bildirim</div>
            <div class="page-sub" id="pageSub">Yeni bir kullanıcı bildirimi ekle</div>
        </div>
    </div>
    <div class="topbar-right">
        <div class="theme-switch" id="themeSwitch">
            <button class="theme-btn" id="themeBtn"><span class="theme-dot" id="themeDot"></span> Tema ▾</button>
            <div class="theme-menu" id="themeMenu">
                <button class="theme-opt active" data-theme="midnight"><span class="sw" style="background:linear-gradient(135deg,#7C5CFF,#4F8CFF)"></span> 🌙 Midnight</button>
                <button class="theme-opt" data-theme="aurora"><span class="sw" style="background:linear-gradient(135deg,#34D8C7,#6C5CE7)"></span> 🌌 Aurora</button>
                <button class="theme-opt" data-theme="purple"><span class="sw" style="background:linear-gradient(135deg,#A855F7,#EC4899)"></span> 💜 Purple</button>
                <button class="theme-opt" data-theme="ocean"><span class="sw" style="background:linear-gradient(135deg,#2DA8FF,#00C2D1)"></span> 💙 Ocean</button>
                <button class="theme-opt" data-theme="graphite"><span class="sw" style="background:linear-gradient(135deg,#9CA3AF,#6B7280)"></span> 🩶 Graphite</button>
                <button class="theme-opt" data-theme="light"><span class="sw" style="background:linear-gradient(135deg,#7C5CFF,#00B894)"></span> 🤍 Light</button>
            </div>
        </div>
        <div class="admin-mini" style="padding:6px 10px;"><div class="av" style="width:30px;height:30px;"></div></div>
    </div>
</div>
<div class="content">
    <section class="view active">
        <div class="view-head">
            <div><h2>Yeni Bildirim</h2><p>Yeni bir kullanıcı bildirimi ekle.</p></div>
            <div class="head-actions">
                <a class="btn btn-ghost" href="@Url.Action("NotificationList", "AdminNotification")">← Listeye Dön</a>
            </div>
        </div>
        <div class="card" style="max-width:520px;margin:0 auto;">
            <form asp-controller="AdminNotification" asp-action="NotificationCreate" method="post">
                @Html.AntiForgeryToken()
                <div class="f-row">
                    <label>Kullanıcı Id</label>
                    <input type="text" asp-for="AppUserId" placeholder="Kullanıcı Id girin" />
                    <span asp-validation-for="AppUserId" style="color:var(--danger);font-size:11.5px;"></span>
                </div>
                <div class="f-row">
                    <label>Başlık</label>
                    <input type="text" asp-for="Title" placeholder="örn. Etkinlik Hatırlatması" />
                    <span asp-validation-for="Title" style="color:var(--danger);font-size:11.5px;"></span>
                </div>
                <div class="f-row">
                    <label>Mesaj</label>
                    <textarea asp-for="Message" placeholder="Bildirim mesajı..."></textarea>
                    <span asp-validation-for="Message" style="color:var(--danger);font-size:11.5px;"></span>
                </div>
                <div style="display:flex;gap:10px;margin-top:10px;">
                    <button type="submit" class="btn btn-primary">Kaydet</button>
                    <a class="btn btn-ghost" href="@Url.Action("NotificationList", "AdminNotification")">Vazgeç</a>
                </div>
            </form>
        </div>
    </section>
</div>