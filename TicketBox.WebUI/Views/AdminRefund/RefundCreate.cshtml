@model CreateRefundCommand
@{
    ViewData["Title"] = "RefundCreate";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="topbar">
    <div class="topbar-left">
        <button class="menu-toggle" id="menuToggle">☰</button>
        <div>
            <div class="page-title" id="pageTitle">Yeni İade Talebi</div>
            <div class="page-sub" id="pageSub">Sisteme manuel iade talebi gir</div>
        </div>
    </div>
    <div class="topbar-right">
        <div class="theme-switch" id="themeSwitch">
            <button class="theme-btn" id="themeBtn"><span class="theme-dot" id="themeDot"></span> Tema ▾</button>
            <div class="theme-menu" id="themeMenu">
                <button class="theme-opt active" data-theme="midnight"><span class="sw" style="background:linear-gradient(135deg,#7C5CFF,#4F8CFF)"></span> 🌙 Midnight</button>
                <button class="theme-opt" data-theme="aurora"><span class="sw" style="background:linear-gradient(135deg,#34D8C7,#6C5CE7)"></span> 🌌 Aurora</button>
                <button class="theme-opt" data-theme="purple"><span class="sw" style="background:linear-gradient(135deg,#A855F7,#EC4899)"></span> 💜 Purple</button>
                <button class="theme-opt" data-theme="ocean"><span class="sw" style="background:linear-gradient(135deg,#2DA8FF,#00C2D1)"></span> 💙 Ocean</button>
                <button class="theme-opt" data-theme="graphite"><span class="sw" style="background:linear-gradient(135deg,#9CA3AF,#6B7280)"></span> 🩶 Graphite</button>
                <button class="theme-opt" data-theme="light"><span class="sw" style="background:linear-gradient(135deg,#7C5CFF,#00B894)"></span> 🤍 Light</button>
            </div>
        </div>
        <div class="admin-mini" style="padding:6px 10px;"><div class="av" style="width:30px;height:30px;"></div></div>
    </div>
</div>

<div class="content">
    <section class="view active">
        <div class="view-head">
            <div><h2>Yeni İade Talebi</h2><p>Yeni bir iade kaydı oluşturun.</p></div>
            <div class="head-actions">
                <a class="btn btn-ghost" href="@Url.Action("RefundList", "AdminRefund")">← Listeye Dön</a>
            </div>
        </div>

        <div class="card" style="max-width:520px;margin:0 auto;">
            <form asp-controller="AdminRefund" asp-action="RefundCreate" method="post">
                @Html.AntiForgeryToken()

                <div class="f-row">
                    <label>Bilet ID</label>
                    <input type="number" asp-for="TicketId" placeholder="Bilet ID giriniz" />
                    <span asp-validation-for="TicketId" style="color:var(--danger);font-size:11.5px;"></span>
                </div>

                <div class="f-row">
                    <label>Ödeme ID</label>
                    <input type="number" asp-for="PaymentId" placeholder="Ödeme ID giriniz" />
                    <span asp-validation-for="PaymentId" style="color:var(--danger);font-size:11.5px;"></span>
                </div>

                <div class="f-row">
                    <label>İade Tutarı (₺)</label>
                    <input type="number" step="0.01" asp-for="RefundAmount" placeholder="0.00" />
                    <span asp-validation-for="RefundAmount" style="color:var(--danger);font-size:11.5px;"></span>
                </div>

                <div class="f-row">
                    <label>İade Sebebi</label>
                    <textarea asp-for="Reason" placeholder="İade sebebini belirtiniz..."></textarea>
                    <span asp-validation-for="Reason" style="color:var(--danger);font-size:11.5px;"></span>
                </div>

                <div style="display:flex;gap:10px;margin-top:10px;">
                    <button type="submit" class="btn btn-primary">Kaydet</button>
                    <a class="btn btn-ghost" href="@Url.Action("RefundList", "AdminRefund")">Vazgeç</a>
                </div>
            </form>
        </div>
    </section>
</div>