@model List<GetRefundQueryResult>
@{
    ViewData["Title"] = "RefundList";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="topbar">
    <div class="topbar-left">
        <button class="menu-toggle" id="menuToggle">☰</button>
        <div>
            <div class="page-title" id="pageTitle">İadeler</div>
            <div class="page-sub" id="pageSub">Bilet iade taleplerini ve durumlarını yönet</div>
        </div>
    </div>
    <div class="topbar-right">
        <div class="search-box"><span>🔍</span><input placeholder="İade veya PNR ara..."></div>
        <button class="icon-btn">🔔<span class="dot"></span></button>
        <div class="theme-switch" id="themeSwitch">
            <button class="theme-btn" id="themeBtn"><span class="theme-dot" id="themeDot"></span> Tema ▾</button>
            <div class="theme-menu" id="themeMenu">
                <button class="theme-opt active" data-theme="midnight"><span class="sw" style="background:linear-gradient(135deg,#7C5CFF,#4F8CFF)"></span> 🌙 Midnight</button>
                <button class="theme-opt" data-theme="aurora"><span class="sw" style="background:linear-gradient(135deg,#34D8C7,#6C5CE7)"></span> 🌌 Aurora</button>
                <button class="theme-opt" data-theme="purple"><span class="sw" style="background:linear-gradient(135deg,#A855F7,#EC4899)"></span> 💜 Purple</button>
                <button class="theme-opt" data-theme="ocean"><span class="sw" style="background:linear-gradient(135deg,#2DA8FF,#00C2D1)"></span> 💙 Ocean</button>
                <button class="theme-opt" data-theme="graphite"><span class="sw" style="background:linear-gradient(135deg,#9CA3AF,#6B7280)"></span> 🩶 Graphite</button>
                <button class="theme-opt" data-theme="light"><span class="sw" style="background:linear-gradient(135deg,#7C5CFF,#00B894)"></span> 🤍 Light</button>
            </div>
        </div>
        <div class="admin-mini" style="padding:6px 10px;"><div class="av" style="width:30px;height:30px;"></div></div>
    </div>
</div>

<div class="content">
    <section class="view active" id="view-refunds" data-filter-scope="refunds">
        <div class="view-head">
            <div><h2>İade Talepleri</h2><p>İade isteklerini inceleyin, onaylayın veya reddedin.</p></div>
            <div class="head-actions">
                <a class="btn btn-primary" href="@Url.Action("RefundCreate", "AdminRefund")">+ Yeni İade Talebi</a>
            </div>
        </div>
        <div class="table-card">
            <div class="table-toolbar">
                <div class="filter-chips">
                    <button class="f-chip active" data-filter="all">Tümü (@(Model?.Count ?? 0))</button>
                    <button class="f-chip" data-filter="pending">Beklemede</button>
                    <button class="f-chip" data-filter="approved">Onaylandı</button>
                    <button class="f-chip" data-filter="rejected">Reddedildi</button>
                </div>
                <div class="search-box" style="width:220px;"><span>🔍</span><input placeholder="PNR Kodu ara..."></div>
            </div>
            <table>
                <thead>
                    <tr>
                        <th style="width:12%;">PNR Kodu</th>
                        <th style="width:12%;">Tutar</th>
                        <th style="width:25%;">İade Nedeni</th>
                        <th style="width:13%;">Durum</th>
                        <th style="width:14%;">Talep Tarihi</th>
                        <th style="width:14%;">İşlem Tarihi</th>
                        <th style="width:10%;text-align:right;">İşlem</th>
                    </tr>
                </thead>
                <tbody id="refundsBody">
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            var statusGroup = item.Status == "Onaylandı" ? "approved" : (item.Status == "Beklemede" ? "pending" : "rejected");
                            <tr data-status="@statusGroup">
                                <td>
                                    <div class="cell-main">
                                        <div class="cell-title" style="font-weight:600;color:var(--primary);">@item.PNRCode</div>
                                    </div>
                                </td>
                                <td>@item.RefundAmount.ToString("C2")</td>
                                <td><span title="@item.Reason">@(item.Reason?.Length > 35 ? item.Reason.Substring(0, 35) + "..." : item.Reason)</span></td>
                                <td>
                                    @if (item.Status == "Onaylandı")
                                    {
                                        <span class="badge green">Onaylandı</span>
                                    }
                                    else if (item.Status == "Beklemede")
                                    {
                                        <span class="badge yellow" style="background:rgba(234,179,8,0.15);color:#eab308;">Beklemede</span>
                                    }
                                    else
                                    {
                                        <span class="badge red" style="background:rgba(239,68,68,0.15);color:#ef4444;">Reddedildi</span>
                                    }
                                </td>
                                <td>@item.RequestDate.ToString("dd.MM.yyyy HH:mm")</td>
                                <td>@(item.ProcessedDate.HasValue? item.ProcessedDate.Value.ToString("dd.MM.yyyy HH:mm") : "-")</td>
                                <td>
                                    <div class="row-actions">
                                        <a class="btn-icon-only" title="Düzenle" href="@Url.Action("RefundUpdate", "AdminRefund", new { id = item.RefundId })">✎</a>
                                        <form method="post" action="@Url.Action("RefundDelete", "AdminRefund")" style="display:inline;" onsubmit="return confirm('Bu iade kaydını silmek istediğinize emin misiniz?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.RefundId" />
                                            <button type="submit" class="btn-icon-only" title="Sil" style="color:var(--danger);">🗑</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="empty-hint">Henüz iade kaydı bulunamadı.</td>
                        </tr>
                    }
                </tbody>
            </table>
            <div class="table-foot">
                <span>@(Model?.Count ?? 0) kayıt gösteriliyor</span>
            </div>
        </div>
    </section>
</div>

<script>
    (function () {
        const view = document.querySelector('[data-filter-scope="refunds"]');
        if (!view) return;
        const chipGroup = view.querySelector('.filter-chips');
        const tbody = view.querySelector('tbody');
        if (!chipGroup || !tbody) return;

        chipGroup.querySelectorAll('.f-chip').forEach(chip => {
            chip.addEventListener('click', () => {
                chipGroup.querySelectorAll('.f-chip').forEach(c => c.classList.remove('active'));
                chip.classList.add('active');
                const filter = chip.dataset.filter;
                tbody.querySelectorAll('tr[data-status]').forEach(row => {
                    row.style.display = (filter === 'all' || row.dataset.status === filter) ? '' : 'none';
                });
            });
        });
    })();
</script>