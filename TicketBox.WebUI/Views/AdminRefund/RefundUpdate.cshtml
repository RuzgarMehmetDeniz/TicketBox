@model UpdateRefundCommand
@{
    ViewData["Title"] = "RefundUpdate";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="topbar">
    <div class="topbar-left">
        <button class="menu-toggle" id="menuToggle">☰</button>
        <div>
            <div class="page-title" id="pageTitle">İade Talebi Güncelle</div>
            <div class="page-sub" id="pageSub">İade durumunu değiştir ve sonlandır</div>
        </div>
    </div>
    <div class="topbar-right">
        <div class="theme-switch" id="themeSwitch">
            <button class="theme-btn" id="themeBtn"><span class="theme-dot" id="themeDot"></span> Tema ▾</button>
            <div class="theme-menu" id="themeMenu">
                <button class="theme-opt active" data-theme="midnight"><span class="sw" style="background:linear-gradient(135deg,#7C5CFF,#4F8CFF)"></span> 🌙 Midnight</button>
                <button class="theme-opt" data-theme="aurora"><span class="sw" style="background:linear-gradient(135deg,#34D8C7,#6C5CE7)"></span> 🌌 Aurora</button>
                <button class="theme-opt" data-theme="purple"><span class="sw" style="background:linear-gradient(135deg,#A855F7,#EC4899)"></span> 💜 Purple</button>
                <button class="theme-opt" data-theme="ocean"><span class="sw" style="background:linear-gradient(135deg,#2DA8FF,#00C2D1)"></span> 💙 Ocean</button>
                <button class="theme-opt" data-theme="graphite"><span class="sw" style="background:linear-gradient(135deg,#9CA3AF,#6B7280)"></span> 🩶 Graphite</button>
                <button class="theme-opt" data-theme="light"><span class="sw" style="background:linear-gradient(135deg,#7C5CFF,#00B894)"></span> 🤍 Light</button>
            </div>
        </div>
        <div class="admin-mini" style="padding:6px 10px;"><div class="av" style="width:30px;height:30px;"></div></div>
    </div>
</div>

<div class="content">
    <section class="view active">
        <div class="view-head">
            <div><h2>İade Durumunu Güncelle</h2><p>#@Model.RefundId numaralı iade talebini yönetin.</p></div>
            <div class="head-actions">
                <a class="btn btn-ghost" href="@Url.Action("RefundList", "AdminRefund")">← Listeye Dön</a>
            </div>
        </div>

        <div class="card" style="max-width:520px;margin:0 auto;">
            <form asp-controller="AdminRefund" asp-action="RefundUpdate" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="RefundId" />

                <div class="f-row">
                    <label>İade Durumu</label>
                    <select asp-for="Status" style="width:100%;padding:10px;border-radius:8px;border:1px solid var(--border);background:var(--bg-input);color:var(--text-main);">
                        <option value="Beklemede">Beklemede</option>
                        <option value="Onaylandı">Onaylandı</option>
                        <option value="Reddedildi">Reddedildi</option>
                    </select>
                    <span asp-validation-for="Status" style="color:var(--danger);font-size:11.5px;"></span>
                </div>

                <div style="display:flex;gap:10px;margin-top:20px;">
                    <button type="submit" class="btn btn-primary">Güncelle</button>
                    <a class="btn btn-ghost" href="@Url.Action("RefundList", "AdminRefund")">Vazgeç</a>
                </div>
            </form>
        </div>
    </section>
</div>