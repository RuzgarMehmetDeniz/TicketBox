@model List<GetReviewQueryResult>
@{
    ViewData["Title"] = "ReviewList";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="topbar">
    <div class="topbar-left">
        <button class="menu-toggle" id="menuToggle">☰</button>
        <div>
            <div class="page-title" id="pageTitle">Değerlendirmeler</div>
            <div class="page-sub" id="pageSub">Etkinlik yorumlarını ve puanlamaları yönet</div>
        </div>
    </div>
    <div class="topbar-right">
        <div class="search-box"><span>🔍</span><input placeholder="Yorum veya etkinlik ara..."></div>
        <button class="icon-btn">🔔<span class="dot"></span></button>
        <div class="theme-switch" id="themeSwitch">
            <button class="theme-btn" id="themeBtn"><span class="theme-dot" id="themeDot"></span> Tema ▾</button>
            <div class="theme-menu" id="themeMenu">
                <button class="theme-opt active" data-theme="midnight"><span class="sw" style="background:linear-gradient(135deg,#7C5CFF,#4F8CFF)"></span> 🌙 Midnight</button>
                <button class="theme-opt" data-theme="aurora"><span class="sw" style="background:linear-gradient(135deg,#34D8C7,#6C5CE7)"></span> 🌌 Aurora</button>
                <button class="theme-opt" data-theme="purple"><span class="sw" style="background:linear-gradient(135deg,#A855F7,#EC4899)"></span> 💜 Purple</button>
                <button class="theme-opt" data-theme="ocean"><span class="sw" style="background:linear-gradient(135deg,#2DA8FF,#00C2D1)"></span> 💙 Ocean</button>
                <button class="theme-opt" data-theme="graphite"><span class="sw" style="background:linear-gradient(135deg,#9CA3AF,#6B7280)"></span> 🩶 Graphite</button>
                <button class="theme-opt" data-theme="light"><span class="sw" style="background:linear-gradient(135deg,#7C5CFF,#00B894)"></span> 🤍 Light</button>
            </div>
        </div>
        <div class="admin-mini" style="padding:6px 10px;"><div class="av" style="width:30px;height:30px;"></div></div>
    </div>
</div>

<div class="content">
    <section class="view active" id="view-reviews">
        <div class="view-head">
            <div><h2>Yorumlar & Değerlendirmeler</h2><p>Etkinlikler için gelen tüm müşteri yorumlarını listeleyin.</p></div>
            <div class="head-actions">
                <a class="btn btn-primary" href="@Url.Action("ReviewCreate", "AdminReview")">+ Yeni Yorum Ekle</a>
            </div>
        </div>
        <div class="table-card">
            <div class="table-toolbar">
                <div class="search-box" style="width:260px;"><span>🔍</span><input placeholder="Yorum veya etkinlik ara..."></div>
            </div>
            <table>
                <thead>
                    <tr>
                        <th style="width:20%;">Etkinlik</th>
                        <th style="width:18%;">Kullanıcı ID</th>
                        <th style="width:12%;">Puan</th>
                        <th style="width:30%;">Yorum</th>
                        <th style="width:10%;">Tarih</th>
                        <th style="width:10%;text-align:right;">İşlem</th>
                    </tr>
                </thead>
                <tbody id="reviewsBody">
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <div class="cell-main">
                                        <div class="cell-title" style="font-weight:600;color:var(--primary);">@item.EventTitle</div>
                                    </div>
                                </td>
                                <td><span style="font-size:12px;opacity:0.8;">@item.AppUserId</span></td>
                                <td>⭐ @item.Rating/5</td>
                                <td><span title="@item.Comment">@(item.Comment?.Length > 35 ? item.Comment.Substring(0, 35) + "..." : (item.Comment ?? "-"))</span></td>
                                <td>@item.CreatedDate.ToString("dd.MM.yyyy HH:mm")</td>
                                <td>
                                    <div class="row-actions">
                                        <a class="btn-icon-only" title="Düzenle" href="@Url.Action("ReviewUpdate", "AdminReview", new { id = item.ReviewId })">✎</a>
                                        <form method="post" action="@Url.Action("ReviewDelete", "AdminReview")" style="display:inline;" onsubmit="return confirm('Bu yorumu silmek istediğinize emin misiniz?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.ReviewId" />
                                            <button type="submit" class="btn-icon-only" title="Sil" style="color:var(--danger);">🗑</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="empty-hint">Henüz değerlendirme kaydı bulunamadı.</td>
                        </tr>
                    }
                </tbody>
            </table>
            <div class="table-foot">
                <span>@(Model?.Count ?? 0) kayıt gösteriliyor</span>
            </div>
        </div>
    </section>
</div>