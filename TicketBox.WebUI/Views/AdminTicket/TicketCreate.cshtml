@model CreateTicketCommand
@{
    ViewData["Title"] = "TicketCreate";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="topbar">
    <div class="topbar-left">
        <button class="menu-toggle" id="menuToggle">☰</button>
        <div>
            <div class="page-title" id="pageTitle">Manuel Bilet Oluştur</div>
            <div class="page-sub" id="pageSub">Etkinlik için yeni bir bilet tanımlayın</div>
        </div>
    </div>
    <div class="topbar-right">
        <div class="theme-switch" id="themeSwitch">
            <button class="theme-btn" id="themeBtn"><span class="theme-dot" id="themeDot"></span> Tema ▾</button>
            <div class="theme-menu" id="themeMenu">
                <button class="theme-opt active" data-theme="midnight"><span class="sw" style="background:linear-gradient(135deg,#7C5CFF,#4F8CFF)"></span> 🌙 Midnight</button>
                <button class="theme-opt" data-theme="aurora"><span class="sw" style="background:linear-gradient(135deg,#34D8C7,#6C5CE7)"></span> 🌌 Aurora</button>
                <button class="theme-opt" data-theme="purple"><span class="sw" style="background:linear-gradient(135deg,#A855F7,#EC4899)"></span> 💜 Purple</button>
                <button class="theme-opt" data-theme="ocean"><span class="sw" style="background:linear-gradient(135deg,#2DA8FF,#00C2D1)"></span> 💙 Ocean</button>
                <button class="theme-opt" data-theme="graphite"><span class="sw" style="background:linear-gradient(135deg,#9CA3AF,#6B7280)"></span> 🩶 Graphite</button>
                <button class="theme-opt" data-theme="light"><span class="sw" style="background:linear-gradient(135deg,#7C5CFF,#00B894)"></span> 🤍 Light</button>
            </div>
        </div>
        <div class="admin-mini" style="padding:6px 10px;"><div class="av" style="width:30px;height:30px;"></div></div>
    </div>
</div>

<div class="content">
    <section class="view active">
        <div class="view-head">
            <div><h2>Yeni Bilet</h2><p>Bilet detaylarını girerek sisteme kaydedin.</p></div>
            <div class="head-actions">
                <a class="btn btn-ghost" href="@Url.Action("TicketList", "AdminTicket")">← Listeye Dön</a>
            </div>
        </div>

        <div class="card" style="max-width:520px;margin:0 auto;">
            <form asp-controller="AdminTicket" asp-action="TicketCreate" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" style="color:var(--danger);font-size:12px;margin-bottom:12px;"></div>

                <div class="f-row">
                    <label>Etkinlik ID</label>
                    <input type="number" asp-for="EventId" placeholder="Etkinlik ID giriniz" />
                    <span asp-validation-for="EventId" style="color:var(--danger);font-size:11.5px;"></span>
                </div>

                <div class="f-row">
                    <label>Kullanıcı ID</label>
                    <input type="text" asp-for="AppUserId" placeholder="Kullanıcı GUID/ID giriniz" />
                    <span asp-validation-for="AppUserId" style="color:var(--danger);font-size:11.5px;"></span>
                </div>

                <div class="f-row">
                    <label>Kupon ID (Opsiyonel)</label>
                    <input type="number" asp-for="CouponId" placeholder="Var ise Kupon ID giriniz" />
                    <span asp-validation-for="CouponId" style="color:var(--danger);font-size:11.5px;"></span>
                </div>

                <div style="display:flex;gap:10px;margin-top:15px;">
                    <button type="submit" class="btn btn-primary">Bilet Oluştur</button>
                    <a class="btn btn-ghost" href="@Url.Action("TicketList", "AdminTicket")">Vazgeç</a>
                </div>
            </form>
        </div>
    </section>
</div>