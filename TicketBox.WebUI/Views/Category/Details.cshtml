@model GetCategoryByIdQueryResult

@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Kategori Detay</title>
</head>
<body>
    <h2>Kategori Detay</h2>

    <p><strong>Ad:</strong> @Model.CategoryName</p>
    <p><strong>Açıklama:</strong> @Model.Description</p>
    <p><strong>İkon URL:</strong> @Model.IconUrl</p>
    <p><strong>Aktif mi:</strong> @(Model.IsActive ? "Evet" : "Hayır")</p>

    <a asp-controller="Category" asp-action="Index">Listeye Dön</a>
</body>
</html>