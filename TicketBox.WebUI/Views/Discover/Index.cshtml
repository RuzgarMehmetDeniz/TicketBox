<!DOCTYPE html>
@{
    Layout = null;
}
<html lang="tr">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>TicketBox — Etkinlik biletleri, yeniden tasarlandı</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap" rel="stylesheet">
    <style>
        /* ============ DESIGN TOKENS ============ */
        :root{
          --indigo: #4338CA;
          --indigo-ink: #2E2A85;
          --purple: #7C3AED;
          --emerald: #10B981;
          --cyan: #06B6D4;
          --bg: #FAFAFA;
          --bg-alt: #F5F6F8;
          --card: #FFFFFF;
          --ink: #1F2126;
          --ink-soft: #5B5F6B;
          --ink-faint: #90939C;
          --border: #E7E8EC;
          --success: #16A34A;
          --warning: #F59E0B;
          --danger: #EF4444;

          --font-display: 'Plus Jakarta Sans', sans-serif;
          --font-body: 'Inter', sans-serif;
          --font-mono: 'IBM Plex Mono', monospace;

          --radius-lg: 18px;
          --radius-md: 14px;
          --radius-sm: 10px;
          --shadow-sm: 0 1px 2px rgba(31,33,38,0.04), 0 1px 1px rgba(31,33,38,0.03);
          --shadow-md: 0 8px 24px rgba(46,42,133,0.08);
          --shadow-lg: 0 24px 60px rgba(46,42,133,0.14);
          --container: 1200px;
        }

        *{box-sizing:border-box; margin:0; padding:0;}
        html{scroll-behavior:smooth;}
        body{
          font-family: var(--font-body);
          color: var(--ink);
          background: var(--bg);
          -webkit-font-smoothing: antialiased;
          line-height: 1.5;
        }
        img{max-width:100%; display:block;}
        a{color:inherit; text-decoration:none;}
        ul{list-style:none;}
        button{font-family:inherit; cursor:pointer; border:none; background:none;}
        .container{max-width: var(--container); margin: 0 auto; padding: 0 32px;}
        section{padding: 96px 0;}
        h1,h2,h3,h4{font-family: var(--font-display); letter-spacing: -0.02em; color: var(--ink);}
        .mono{font-family: var(--font-mono); letter-spacing: 0.02em;}
        .eyebrow{
          font-family: var(--font-mono);
          font-size: 12.5px;
          font-weight: 600;
          letter-spacing: 0.14em;
          text-transform: uppercase;
          color: var(--indigo);
          display:flex; align-items:center; gap:8px;
          margin-bottom: 16px;
        }
        .eyebrow::before{
          content:""; width:16px; height:2px; background: var(--emerald); border-radius:2px;
        }

        /* ============ BUTTONS ============ */
        .btn{
          display:inline-flex; align-items:center; justify-content:center; gap:8px;
          padding: 14px 26px;
          border-radius: 999px;
          font-weight: 600;
          font-size: 15px;
          transition: transform .18s ease, box-shadow .18s ease, background .18s ease;
          white-space: nowrap;
        }
        .btn-primary{
          background: linear-gradient(135deg, var(--indigo), var(--indigo-ink));
          color: white;
          box-shadow: 0 10px 24px rgba(67,56,202,0.28);
        }
        .btn-primary:hover{ transform: translateY(-2px); box-shadow: 0 14px 30px rgba(67,56,202,0.36); }
        .btn-ghost{
          background: var(--card);
          border: 1px solid var(--border);
          color: var(--ink);
        }
        .btn-ghost:hover{ border-color: var(--indigo); color: var(--indigo); }
        .btn-emerald{
          background: var(--emerald); color:white;
          box-shadow: 0 10px 24px rgba(16,185,129,0.28);
        }
        .btn-emerald:hover{ transform: translateY(-2px); }
        .btn-sm{ padding: 10px 18px; font-size: 13.5px; }
        .btn-icon{
          width:44px; height:44px; border-radius:50%;
          display:inline-flex; align-items:center; justify-content:center;
          background: var(--bg-alt); border:1px solid var(--border);
          transition: all .18s ease;
        }
        .btn-icon:hover{ background: #FDECEC; border-color: #F7C7C7; }
        .btn-icon svg{ width:18px; height:18px; }

        /* ============ NAV ============ */
        header.nav{
          position: sticky; top:0; z-index: 50;
          background: rgba(250,250,250,0.82);
          backdrop-filter: blur(14px);
          border-bottom: 1px solid var(--border);
        }
        .nav-inner{
          display:flex; align-items:center; justify-content:space-between;
          padding: 18px 0;
        }
        .logo{
          font-family: var(--font-display); font-weight: 800; font-size: 21px;
          display:flex; align-items:center; gap:10px;
        }
        .logo-mark{
          width:34px; height:34px; border-radius: 10px;
          background: linear-gradient(135deg, var(--indigo), var(--purple));
          position:relative;
          box-shadow: 0 6px 14px rgba(67,56,202,0.35);
        }
        .logo-mark::after{
          content:""; position:absolute; inset:9px 6px;
          border: 2px dashed rgba(255,255,255,0.7);
          border-radius: 4px;
        }
        .nav-links{ display:flex; gap:36px; align-items:center; }
        .nav-links a{ font-size: 14.5px; font-weight: 500; color: var(--ink-soft); transition: color .15s; }
        .nav-links a:hover{ color: var(--indigo); }
        .nav-actions{ display:flex; align-items:center; gap:14px; }
        @@media (max-width: 900px){ .nav-links{display:none;} }

        /* ============ HERO ============ */
        .hero{
          position:relative;
          padding: 88px 0 110px;
          overflow: hidden;
        }
        .hero::before{
          content:"";
          position:absolute; top:-180px; right:-140px;
          width:640px; height:640px; border-radius:50%;
          background: radial-gradient(circle at 30% 30%, rgba(124,58,237,0.20), rgba(6,182,212,0.14) 55%, transparent 72%);
          filter: blur(10px);
        }
        .hero-inner{ position:relative; z-index:1; max-width: 760px; }
        .hero h1{
          font-size: clamp(40px, 5.6vw, 68px);
          line-height: 1.04;
          font-weight: 800;
          margin-bottom: 22px;
        }
        .hero h1 em{
          font-style: normal;
          background: linear-gradient(100deg, var(--indigo), var(--purple) 60%, var(--cyan));
          -webkit-background-clip: text; background-clip:text; color:transparent;
        }
        .hero p.lead{
          font-size: 18px; color: var(--ink-soft); max-width: 540px; margin-bottom: 40px;
        }

        /* search "ticket window" bar */
        .search-bar{
          display:flex; align-items:stretch;
          background: var(--card);
          border: 1px solid var(--border);
          border-radius: 999px;
          padding: 8px;
          box-shadow: var(--shadow-lg);
          max-width: 720px;
          position:relative;
        }
        .search-field{
          flex:1; display:flex; align-items:center; gap:10px; padding: 12px 20px;
          border-right: 1px dashed var(--border);
        }
        .search-field:last-of-type{ border-right:none; }
        .search-field svg{ width:18px; height:18px; color: var(--ink-faint); flex-shrink:0; }
        .search-field input{
          border:none; outline:none; font-family:inherit; font-size:14.5px; width:100%;
          background:transparent; color: var(--ink);
        }
        .search-field label{
          display:none;
        }
        .search-field span.field-label{ font-size:11px; color:var(--ink-faint); text-transform:uppercase; letter-spacing:.06em; display:block; margin-bottom:2px;}
        .search-bar .btn{ margin-left:4px; flex-shrink:0; }

        .hero-highlight{
          margin-top: 44px;
          display:inline-flex; align-items:center; gap:14px;
          padding: 10px 10px 10px 18px;
          background: var(--card);
          border:1px solid var(--border);
          border-radius: 999px;
          box-shadow: var(--shadow-sm);
          font-size: 13.5px;
        }
        .pulse-dot{
          width:8px; height:8px; border-radius:50%; background: var(--emerald);
          box-shadow: 0 0 0 0 rgba(16,185,129,0.5);
          animation: pulse 2s infinite;
        }
        @@keyframes pulse{
          0%{ box-shadow: 0 0 0 0 rgba(16,185,129,0.45); }
          70%{ box-shadow: 0 0 0 8px rgba(16,185,129,0); }
          100%{ box-shadow: 0 0 0 0 rgba(16,185,129,0); }
        }
        .hero-highlight strong{ font-family: var(--font-mono); font-weight:600; }
        .hero-highlight .chip-badge{
          background: var(--bg-alt); padding:5px 10px; border-radius:999px; font-family: var(--font-mono); font-size:11.5px; color:var(--indigo); font-weight:600;
        }

        /* ============ SECTION HEAD ============ */
        .section-head{
          display:flex; align-items:flex-end; justify-content:space-between;
          margin-bottom: 44px; gap: 24px; flex-wrap:wrap;
        }
        .section-head h2{ font-size: clamp(28px,3.2vw,38px); font-weight:800; }
        .section-head p{ color: var(--ink-soft); font-size:15.5px; max-width:460px; margin-top:8px;}
        .view-all{ font-size:14px; font-weight:600; color:var(--indigo); display:flex; align-items:center; gap:6px; white-space:nowrap;}

        /* ============ CATEGORIES ============ */
        .cat-grid{
          display:grid; grid-template-columns: repeat(4,1fr); gap:18px;
        }
        .cat-card{
          background: var(--card); border:1px solid var(--border); border-radius: var(--radius-md);
          padding: 26px 22px; transition: all .2s ease; position:relative; overflow:hidden;
        }
        .cat-card:hover{ transform: translateY(-4px); box-shadow: var(--shadow-md); border-color:transparent; }
        .cat-icon{
          width:46px; height:46px; border-radius:12px; display:flex; align-items:center; justify-content:center;
          margin-bottom:18px; font-size:20px;
        }
        .cat-card h4{ font-size:15.5px; font-weight:700; margin-bottom:4px; }
        .cat-card span{ font-size:13px; color: var(--ink-faint); font-family: var(--font-mono);}
        @@media (max-width: 980px){ .cat-grid{grid-template-columns: repeat(2,1fr);} }

        /* ============ EVENT CARD (signature: ticket stub) ============ */
        .event-grid{ display:grid; grid-template-columns: repeat(3,1fr); gap: 26px; }
        .ticket-card{
          background: var(--card);
          border-radius: var(--radius-lg);
          border: 1px solid var(--border);
          overflow: visible;
          position: relative;
          transition: transform .22s ease, box-shadow .22s ease;
        }
        .ticket-card:hover{ transform: translateY(-6px); box-shadow: var(--shadow-lg); }
        .ticket-media{
          position:relative; height: 190px; border-radius: var(--radius-lg) var(--radius-lg) 0 0; overflow:hidden;
          background: linear-gradient(135deg, var(--indigo), var(--purple));
        }
        .ticket-media .fav{
          position:absolute; top:14px; right:14px;
          width:36px; height:36px; border-radius:50%;
          background: rgba(255,255,255,0.92); backdrop-filter: blur(6px);
          display:flex; align-items:center; justify-content:center;
        }
        .ticket-media .cat-tag{
          position:absolute; top:14px; left:14px;
          background: rgba(255,255,255,0.92); padding:6px 12px; border-radius:999px;
          font-size:11.5px; font-weight:700; color: var(--indigo); font-family: var(--font-mono);
        }
        /* the stub cut line + notches */
        .stub-line{
          position:relative; height:0; border-top:2px dashed var(--border);
          margin: 0 22px;
        }
        .stub-line::before, .stub-line::after{
          content:""; position:absolute; top:-11px; width:22px; height:22px; border-radius:50%;
          background: var(--bg);
        }
        .stub-line::before{ left:-33px; }
        .stub-line::after{ right:-33px; }

        .ticket-body{ padding: 18px 22px 22px; }
        .ticket-body h3{ font-size:17.5px; font-weight:700; margin-bottom:10px; line-height:1.3; }
        .ticket-meta{ display:flex; flex-direction:column; gap:7px; margin-bottom:18px; }
        .ticket-meta-row{ display:flex; align-items:center; gap:8px; font-size:13.5px; color: var(--ink-soft); }
        .ticket-meta-row svg{ width:15px; height:15px; color: var(--ink-faint); flex-shrink:0; }
        .ticket-foot{ display:flex; align-items:center; justify-content:space-between; }
        .price{ font-family: var(--font-mono); font-weight:600; font-size:17px; color: var(--ink); }
        .price span{ font-size:12px; color: var(--ink-faint); font-weight:500; }
        @@media (max-width: 980px){ .event-grid{grid-template-columns: repeat(2,1fr);} }
        @@media (max-width: 640px){ .event-grid{grid-template-columns: 1fr;} }

        /* ============ UPCOMING TIMELINE ============ */
        .timeline{ display:flex; gap:20px; overflow-x:auto; padding-bottom:12px; scrollbar-width:none;}
        .timeline::-webkit-scrollbar{ display:none; }
        .tl-card{
          flex: 0 0 300px; background: var(--card); border:1px solid var(--border); border-radius: var(--radius-md);
          padding: 20px; display:flex; gap:16px; position:relative;
        }
        .tl-date{
          flex-shrink:0; width:58px; height:58px; border-radius: 12px;
          background: var(--bg-alt); display:flex; flex-direction:column; align-items:center; justify-content:center;
          font-family: var(--font-mono);
        }
        .tl-date .d{ font-size:19px; font-weight:700; color: var(--indigo); line-height:1;}
        .tl-date .m{ font-size:10.5px; color: var(--ink-faint); text-transform:uppercase; margin-top:2px;}
        .tl-card h4{ font-size:14.5px; font-weight:700; margin-bottom:6px; }
        .tl-card p{ font-size:12.5px; color: var(--ink-faint); }
        .tl-card::before{
          content:""; position:absolute; left:0; right:0; bottom:-14px; height:2px;
          background: repeating-linear-gradient(90deg, var(--border) 0 6px, transparent 6px 12px);
        }

        /* ============ WHY / FEATURES ============ */
        .feat-grid{ display:grid; grid-template-columns: repeat(5,1fr); gap:16px; }
        .feat-card{
          background: var(--card); border:1px solid var(--border); border-radius: var(--radius-md);
          padding: 24px 18px; text-align:left;
        }
        .feat-icon{
          width:42px; height:42px; border-radius:12px; margin-bottom:16px;
          display:flex; align-items:center; justify-content:center; font-size:18px;
          background: var(--bg-alt);
        }
        .feat-card h4{ font-size:14.5px; font-weight:700; margin-bottom:6px; }
        .feat-card p{ font-size:12.8px; color: var(--ink-faint); line-height:1.5;}
        @@media (max-width: 980px){ .feat-grid{grid-template-columns: repeat(2,1fr);} }

        /* ============ STATS ============ */
        .stats-band{
          background: linear-gradient(120deg, var(--indigo-ink), var(--indigo) 55%, var(--purple));
          border-radius: 24px; padding: 56px 40px; color:white;
          display:grid; grid-template-columns: repeat(4,1fr); gap:24px; position:relative; overflow:hidden;
        }
        .stats-band::after{
          content:""; position:absolute; inset:0;
          background: radial-gradient(circle at 85% 20%, rgba(6,182,212,0.35), transparent 45%);
        }
        .stat{ position:relative; z-index:1; }
        .stat .num{ font-family: var(--font-display); font-size: 40px; font-weight:800; letter-spacing:-0.02em;}
        .stat .lbl{ font-size:13px; opacity:.78; margin-top:6px; font-family: var(--font-mono); text-transform:uppercase; letter-spacing:.05em;}
        @@media (max-width: 900px){ .stats-band{grid-template-columns: repeat(2,1fr);} }

        /* ============ REVIEWS ============ */
        .review-grid{ display:grid; grid-template-columns: repeat(3,1fr); gap:22px; }
        .review-card{
          background: var(--card); border:1px solid var(--border); border-radius: var(--radius-md);
          padding: 26px;
        }
        .stars{ color: var(--warning); font-size:14px; margin-bottom:14px; letter-spacing:2px;}
        .review-card p.quote{ font-size:14.5px; color: var(--ink-soft); line-height:1.6; margin-bottom:20px;}
        .reviewer{ display:flex; align-items:center; gap:12px; }
        .avatar{ width:38px; height:38px; border-radius:50%; background: linear-gradient(135deg,var(--purple),var(--cyan)); flex-shrink:0;}
        .reviewer h5{ font-size:13.5px; font-weight:700; }
        .reviewer span{ font-size:12px; color: var(--ink-faint); }
        @@media (max-width: 980px){ .review-grid{grid-template-columns: 1fr;} }

        /* ============ FAQ ============ */
        .faq-list{ max-width: 760px; margin:0 auto; }
        .faq-item{ border-bottom:1px solid var(--border); }
        .faq-q{
          display:flex; align-items:center; justify-content:space-between;
          padding: 22px 4px; font-weight:600; font-size:15.5px; width:100%; text-align:left;
        }
        .faq-q .icon{ font-size:20px; color: var(--indigo); transition: transform .2s ease; flex-shrink:0; margin-left:16px;}
        .faq-item.open .faq-q .icon{ transform: rotate(45deg); }
        .faq-a{ max-height:0; overflow:hidden; transition: max-height .25s ease; }
        .faq-a p{ padding: 0 4px 22px; color: var(--ink-soft); font-size:14.5px; line-height:1.6; max-width:640px;}
        .faq-item.open .faq-a{ max-height:220px; }

        /* ============ NEWSLETTER ============ */
        .newsletter{
          background: var(--bg-alt); border-radius: 24px; padding: 60px; text-align:center;
          border: 1px solid var(--border);
        }
        .newsletter h2{ font-size:30px; margin-bottom:12px;}
        .newsletter p{ color: var(--ink-soft); margin-bottom:30px;}
        .newsletter form{ display:flex; gap:10px; max-width:420px; margin:0 auto; }
        .newsletter input{
          flex:1; padding:14px 18px; border-radius:999px; border:1px solid var(--border); font-family:inherit; outline:none; background: var(--card);
        }

        /* ============ FOOTER ============ */
        footer{ background: #16171C; color: #C4C6CE; padding: 72px 0 32px; margin-top: 40px;}
        .footer-grid{ display:grid; grid-template-columns: 1.4fr 1fr 1fr 1fr; gap:40px; margin-bottom:56px;}
        footer .logo{ color:white; margin-bottom:16px; }
        footer p.desc{ font-size:13.5px; color:#8C8F99; max-width:280px; line-height:1.6;}
        footer h5{ color:white; font-size:13px; text-transform:uppercase; letter-spacing:.06em; margin-bottom:18px; font-family: var(--font-mono);}
        footer ul li{ margin-bottom:11px; }
        footer ul a{ font-size:13.8px; color:#A8AAB4; transition:color .15s;}
        footer ul a:hover{ color:white; }
        .footer-bottom{ border-top:1px solid #2A2C34; padding-top:26px; display:flex; justify-content:space-between; font-size:12.8px; color:#71737D; flex-wrap:wrap; gap:12px;}
        @@media (max-width:900px){ .footer-grid{grid-template-columns: repeat(2,1fr);} }

        /* ============ RESPONSIVE HERO/SEARCH ============ */
        @@media (max-width: 760px){
          section{ padding: 64px 0; }
          .search-bar{ flex-direction:column; border-radius: 20px; gap:4px; }
          .search-field{ border-right:none; border-bottom:1px dashed var(--border); }
          .search-field:last-of-type{ border-bottom:none; }
          .search-bar .btn{ margin:6px 4px 4px; }
          .stats-band{ grid-template-columns: repeat(2,1fr); padding:36px 24px;}
          .newsletter form{ flex-direction:column; }
        }
    </style>
</head>
<body>

    <!-- ============ NAV ============ -->
    <header class="nav">
        <div class="container nav-inner">
            <div class="logo"><span class="logo-mark"></span>TicketBox</div>
            <nav class="nav-links">
                <a href="#">Etkinlikler</a>
                <a href="#categories">Kategoriler</a>
                <a href="#why">Neden TicketBox</a>
                <a href="#reviews">Yorumlar</a>
            </nav>
            <div class="nav-actions">
                <a href="#" class="btn btn-ghost btn-sm">Giriş yap</a>
                <a href="#" class="btn btn-primary btn-sm">Kayıt ol</a>
            </div>
        </div>
    </header>

    <!-- ============ HERO ============ -->
    <section class="hero">
        <div class="container hero-inner">
            <div class="eyebrow">TB · 2026 Sürümü</div>
            <h1>Bir sonraki <em>unutulmaz anını</em><br>tek biletle yakala.</h1>
            <p class="lead">Konserden konferansa, festivalden tiyatroya — şehrindeki etkinlikleri keşfet, saniyeler içinde bilet al, kapıda telefonunu göster.</p>

            <div class="search-bar">
                <div class="search-field">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7" /><path d="m21 21-4.3-4.3" /></svg>
                    <div style="width:100%">
                        <span class="field-label">Ne arıyorsun?</span>
                        <input type="text" placeholder="Konser, tiyatro, konferans...">
                    </div>
                </div>
                <div class="search-field">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" /><circle cx="12" cy="10" r="3" /></svg>
                    <div style="width:100%">
                        <span class="field-label">Şehir</span>
                        <input type="text" placeholder="İstanbul">
                    </div>
                </div>
                <button class="btn btn-primary">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><circle cx="11" cy="11" r="7" /><path d="m21 21-4.3-4.3" /></svg>
                    Ara
                </button>
            </div>

            <div class="hero-highlight">
                <span class="pulse-dot"></span>
                <span>Bu hafta öne çıkan: <strong>Arkadan Aydınlatma — Boğaziçi Konseri</strong></span>
                <span class="chip-badge">%40 tükendi</span>
            </div>
        </div>
    </section>

    <!-- ============ CATEGORIES ============ -->
    <section id="categories">
        <div class="container">
            <div class="section-head">
                <div>
                    <h2>Kategoriye göre keşfet</h2>
                    <p>İlgi alanına en yakın etkinlikleri tek tıkla filtrele.</p>
                </div>
                <a href="#" class="view-all">Tümünü gör →</a>
            </div>
            <div class="cat-grid">
