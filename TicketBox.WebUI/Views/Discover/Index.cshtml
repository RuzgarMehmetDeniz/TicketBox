                    <span class="chip-badge">%40 tükendi</span>
                </div>
            </div>

            <div class="hero-visual">
                <div class="float-card notif">
                    <div class="ic">🎟️</div>
                    <div><h6>Bilet onaylandı</h6><p>PNR: TB-8F2AK1</p></div>
                </div>
                <div class="phone-mockup">
                    <div class="phone-screen">
                        <div class="notch"></div>
                        <div class="phone-ticket">
                            <h5>Boğaziçi Konseri</h5>
                            <span>14 Eylül · 20:00</span>
                            <div class="qr"></div>
                            <div class="pnr">PNR · TB-8F2AK1</div>
                        </div>
                    </div>
                </div>
                <div class="float-card mini-event">
                    <img src="https://images.unsplash.com/photo-1459749411175-04bf5292ceea?auto=format&fit=crop&w=120&q=60" alt="" onerror="this.style.display='none'">
                    <div><h6>NEXT.26 Konferansı</h6><span>22 Eki · Zorlu PSM</span></div>
                </div>
                <div class="float-card rating">
