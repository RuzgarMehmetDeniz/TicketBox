@{
	Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
	@await Component.InvokeAsync("_DiscoverHeadComponentPartial")
<body data-theme="midnight">
	<div class="bg-noise"></div>
	<div class="bg-grid"></div>
	<div class="bg-glow-a"></div>
	<div class="bg-glow-b"></div>

	<style>
		.error-wrap {
			min-height: 100vh;
			display: flex;
			align-items: center;
			justify-content: center;
			padding: 60px 20px;
			position: relative;
			z-index: 1;
			text-align: center;
		}

		.error-card {
			max-width: 520px;
			padding: 50px 40px;
			border-radius: var(--radius-xl);
			box-shadow: var(--shadow-lift);
		}

		.error-code {
			font-family: var(--font-display);
			font-size: 88px;
			font-weight: 700;
			background: var(--grad-brand);
			-webkit-background-clip: text;
			background-clip: text;
			color: transparent;
			line-height: 1;
			margin-bottom: 8px;
		}

		.error-card h2 {
			font-size: 24px;
			margin-bottom: 12px;
		}

		.error-card p {
			color: var(--subtitle);
			font-size: 14.5px;
			line-height: 1.6;
			margin-bottom: 28px;
		}
	</style>

	<div class="error-wrap">
		<div class="error-card glass reveal in">
			<div class="error-code">404</div>
			<h2>Sayfa bulunamadı</h2>
			<p>Aradığın sayfa taşınmış, silinmiş ya da hiç var olmamış olabilir.</p>
			<a href="/Discover/Index3" class="btn btn-primary">Ana sayfaya dön</a>
		</div>
	</div>
</body>
</html>