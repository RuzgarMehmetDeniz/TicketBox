@model TicketBox.Application.Features.CQRS.Events.Results.GetEventDetailQueryResult
@{
    Layout = null;
    bool isFavorited = ViewData["IsFavorited"] as bool? ?? false;
}
<!DOCTYPE html>
<html lang="tr">
    @await Component.InvokeAsync("_DiscoverHeadComponentPartial")
<body data-theme="midnight">
    <div class="bg-noise"></div>
    <div class="bg-grid"></div>
    <div class="bg-glow-a"></div>
    <div class="bg-glow-b"></div>

    @await Component.InvokeAsync("_DiscoverNavbarComponentPartial")

    <section class="section" id="eventDetail">
        <div class="wrap">
            <div class="event-detail-hero" style="@(string.IsNullOrEmpty(Model.ImageUrl) ? "" : $"background-image:url('{Model.ImageUrl}');")">
                <span class="ev-badge">@Model.CategoryName</span>
            </div>

            <div class="event-detail-body reveal">
                <div style="display:flex; align-items:center; gap:12px;">
                    <h1>@Model.Title</h1>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <button type="button" class="fav-toggle-btn @(isFavorited ? "active" : "")" id="favToggleBtn" data-event-id="@Model.EventId">♥</button>
                    }
                </div>
                <div class="ev-meta">
                    <span>📍 @Model.Location</span>
                    <span>🕒 @Model.EventDate.ToString("dd MMM yyyy, HH:mm")</span>
                    <span class="rating">★ @Model.AverageRating</span>
                </div>

                <p class="event-desc">@Model.Description</p>

                <div class="ev-fill"><i style="width:@(Model.FillPercentage)%;"></i></div>
                <div class="ev-fill-label">
                    <span>@Model.FillPercentage% dolu</span>
                    <span>👥 @(Model.Capacity - Model.RemainingCapacity) katılımcı</span>
                </div>

                <div class="ev-org">
                    <div class="av"></div>
                    <span>Organizatör: @Model.OrganizerName</span>
                </div>

                @if (Model.GalleryImageUrls.Any())
                {
                    <div class="ev-gallery">
                        @foreach (var img in Model.GalleryImageUrls)
                        {
                            <img src="@img" />
                        }
                    </div>
                }

                <div class="ev-foot">
                    <div class="ev-price"><b>₺@Model.Price</b><span>başlangıç fiyatı</span></div>
                    <div class="ev-actions">
                        @if (Model.RemainingCapacity > 0)
                        {
                            <a asp-controller="Ticket" asp-action="Reservation" asp-route-eventId="@Model.EventId" class="icon-btn" title="Rezervasyon Yap">🎟️</a>
                        }
                        else
                        {
                            <span class="sold-out">Tükendi</span>
                        }
                        <button class="icon-btn" title="QR">▤</button>
                        <button class="icon-btn" title="Paylaş">↗</button>
                    </div>
                </div>

                <div class="ev-reviews reveal">
                    <h3>Yorumlar (@Model.Reviews.Count)</h3>

                    @if (TempData["ReviewError"] != null)
                    {
                        <p class="sold-out">@TempData["ReviewError"]</p>
                    }

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <form asp-controller="Review" asp-action="Create" method="post" class="review-form">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="eventId" value="@Model.EventId" />
                            <div class="rating-select">
                                <label>Puanınız:</label>
                                <select name="rating" required>
                                    <option value="">Seçiniz</option>
                                    <option value="5">★★★★★ (5)</option>
                                    <option value="4">★★★★ (4)</option>
                                    <option value="3">★★★ (3)</option>
                                    <option value="2">★★ (2)</option>
                                    <option value="1">★ (1)</option>
                                </select>
                            </div>
                            <textarea name="comment" placeholder="Yorumunuzu yazın (opsiyonel)" rows="3"></textarea>
                            <button type="submit" class="btn btn-primary btn-sm">Yorum Yap</button>
                        </form>
                    }
                    else
                    {
                        <p class="no-reviews">Yorum yapabilmek için <a href="/Login/Index">giriş yapın</a>.</p>
                    }

                    @if (!Model.Reviews.Any())
                    {
                        <p class="no-reviews">Henüz yorum yapılmamış.</p>
                    }
                    @foreach (var r in Model.Reviews)
                    {
                        <div class="review-item">
                            <b>@r.UserName</b> — ★ @r.Rating
                            <span class="review-date">@r.CreatedDate.ToString("dd MMM yyyy")</span>
                            @if (!string.IsNullOrEmpty(r.Comment))
                            {
                                <p>@r.Comment</p>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </section>

    @await Component.InvokeAsync("_DiscoverFooterComponentPartial")
    @await Component.InvokeAsync("_DiscoverScriptComponentPartial")

    <form id="afToken" style="display:none">@Html.AntiForgeryToken()</form>

    <script>
        const favBtn = document.getElementById('favToggleBtn');

        if (favBtn) {
            favBtn.addEventListener('click', async function () {
                const tokenInput = document.querySelector('#afToken input[name="__RequestVerificationToken"]');
                if (!tokenInput) {
                    console.error('Antiforgery token bulunamadı.');
                    return;
                }

                try {
                    const res = await fetch('/Favorite/Toggle', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                        credentials: 'same-origin',
                        body: '__RequestVerificationToken=' + encodeURIComponent(tokenInput.value) + '&eventId=' + favBtn.dataset.eventId
                    });

                    if (!res.ok) {
                        console.error('Favorite/Toggle isteği başarısız:', res.status, await res.text());
                        alert('Favori işlemi başarısız oldu (HTTP ' + res.status + '). Konsolu kontrol edin.');
                        return;
                    }

                    const data = await res.json();
                    favBtn.classList.toggle('active', data.favorited);
                } catch (err) {
                    console.error('Favorite/Toggle hata:', err);
                    alert('Favori işlemi sırasında bir hata oluştu.');
                }
            });
        }
    </script>
</body>
</html>