<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TicketBox Admin — Yönetim Paneli</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <style>

        /* ============ DESIGN TOKENS (same system as main site) ============ */
        :root {
            --bg: #0F1117;
            --bg2: #171A22;
            --card: #1D2130;
            --card2: #242939;
            --border: rgba(255,255,255,.06);
            --border-strong: rgba(255,255,255,.12);
            --primary: #7C5CFF;
            --secondary: #4F8CFF;
            --accent: #00D4A4;
            --danger: #FF4D6D;
            --warn: #FFB454;
            --text: #F5F7FA;
            --subtitle: #B8C1D1;
            --primary-rgb: 124,92,255;
            --secondary-rgb: 79,140,255;
            --accent-rgb: 0,212,164;
            --danger-rgb: 255,77,109;
            --warn-rgb: 255,180,84;
            --grad-brand: linear-gradient(135deg,var(--primary),var(--secondary));
            --shadow-lift: 0 20px 60px -15px rgba(0,0,0,.55);
            --radius-xl: 24px;
            --radius-lg: 18px;
            --radius-md: 14px;
            --radius-sm: 10px;
            --font-display: 'Space Grotesk', sans-serif;
            --font-body: 'Inter', sans-serif;
            --font-mono: 'JetBrains Mono', monospace;
            --sidebar-w: 260px;
        }

        [data-theme="aurora"] {
            --bg: #0B1420;
            --bg2: #10192A;
            --card: #142033;
            --card2: #1B2A42;
            --border: rgba(255,255,255,.07);
            --border-strong: rgba(255,255,255,.14);
            --primary: #34D8C7;
            --secondary: #6C5CE7;
            --accent: #7CF29C;
            --danger: #FF6B6B;
            --text: #F2FBFA;
            --subtitle: #A9C6C0;
            --primary-rgb: 52,216,199;
            --secondary-rgb: 108,92,231;
            --accent-rgb: 124,242,156;
        }

        [data-theme="purple"] {
            --bg: #120B1F;
            --bg2: #1A1029;
            --card: #221733;
            --card2: #2B1F40;
            --border: rgba(255,255,255,.07);
            --border-strong: rgba(255,255,255,.14);
            --primary: #A855F7;
            --secondary: #EC4899;
            --accent: #C084FC;
            --danger: #FB7185;
            --text: #F6F3FC;
            --subtitle: #C4B5D6;
            --primary-rgb: 168,85,247;
            --secondary-rgb: 236,72,153;
            --accent-rgb: 192,132,252;
        }

        [data-theme="ocean"] {
            --bg: #081420;
            --bg2: #0D1E2E;
            --card: #12293C;
            --card2: #183651;
            --border: rgba(255,255,255,.06);
            --border-strong: rgba(255,255,255,.13);
            --primary: #2DA8FF;
            --secondary: #00C2D1;
            --accent: #4CE0B3;
            --danger: #FF5D73;
            --text: #EFF7FB;
            --subtitle: #9FC0D1;
            --primary-rgb: 45,168,255;
            --secondary-rgb: 0,194,209;
            --accent-rgb: 76,224,179;
        }

        [data-theme="graphite"] {
            --bg: #15161A;
            --bg2: #1B1D22;
            --card: #212328;
            --card2: #282B32;
            --border: rgba(255,255,255,.06);
            --border-strong: rgba(255,255,255,.12);
            --primary: #9CA3AF;
            --secondary: #6B7280;
            --accent: #34D399;
            --danger: #F87171;
            --text: #F3F4F6;
            --subtitle: #A1A6AD;
            --primary-rgb: 156,163,175;
            --secondary-rgb: 107,114,128;
            --accent-rgb: 52,211,153;
        }

        [data-theme="light"] {
            --bg: #F3F4F8;
            --bg2: #FFFFFF;
            --card: #FFFFFF;
            --card2: #F1F2F8;
            --border: rgba(15,17,23,.08);
            --border-strong: rgba(15,17,23,.16);
            --primary: #7C5CFF;
            --secondary: #4F8CFF;
            --accent: #00B894;
            --danger: #E0455A;
            --text: #14161C;
            --subtitle: #5B6472;
            --primary-rgb: 124,92,255;
            --secondary-rgb: 79,140,255;
            --accent-rgb: 0,184,148;
            --shadow-lift: 0 20px 60px -15px rgba(20,22,28,.15);
        }

        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background: var(--bg);
            color: var(--text);
            font-family: var(--font-body);
            -webkit-font-smoothing: antialiased;
            transition: background .3s ease,color .3s ease;
        }

        img {
            max-width: 100%;
            display: block;
        }

        a {
            color: inherit;
            text-decoration: none;
        }

        button {
            font-family: inherit;
            cursor: pointer;
            border: none;
            background: none;
            color: inherit;
        }

        ul {
            list-style: none;
        }

        h1, h2, h3, h4 {
            font-family: var(--font-display);
            line-height: 1.15;
            letter-spacing: -0.01em;
        }

        input, select, textarea {
            font-family: inherit;
            color: var(--text);
        }

        :focus-visible {
            outline: 2px solid var(--accent);
            outline-offset: 2px;
        }

        .glass {
            background: rgba(255,255,255,.03);
            border: 1px solid var(--border);
            backdrop-filter: blur(20px);
        }

        [data-theme="light"] .glass {
            background: rgba(255,255,255,.7);
        }

        /* ============ LAYOUT ============ */
        .admin-shell {
            display: flex;
            min-height: 100vh;
        }

        /* ---- sidebar ---- */
        .sidebar {
            width: var(--sidebar-w);
            flex-shrink: 0;
            position: fixed;
            top: 0;
            left: 0;
            bottom: 0;
            z-index: 50;
            background: var(--bg2);
            border-right: 1px solid var(--border);
            display: flex;
            flex-direction: column;
            transition: transform .35s cubic-bezier(.2,.8,.2,1), width .3s ease;
        }

        .sidebar-head {
            padding: 22px 20px;
            display: flex;
            align-items: center;
            gap: 10px;
            border-bottom: 1px solid var(--border);
        }

        .logo-mark {
            width: 34px;
            height: 34px;
            border-radius: 10px;
            background: var(--grad-brand);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-family: var(--font-display);
            font-weight: 700;
            font-size: 15px;
            flex-shrink: 0;
            box-shadow: 0 6px 18px -4px rgba(var(--primary-rgb),.6);
        }

        .logo-text {
            font-family: var(--font-display);
            font-weight: 700;
            font-size: 16.5px;
        }

            .logo-text span {
                display: block;
                font-family: var(--font-mono);
                font-size: 10px;
                font-weight: 400;
                color: var(--subtitle);
                letter-spacing: .08em;
            }

        .nav-scroll {
            flex: 1;
            overflow-y: auto;
            padding: 16px 12px;
            scrollbar-width: none;
            -ms-overflow-style: none;
        }

            .nav-scroll::-webkit-scrollbar {
                display: none;
            }

        .nav-group {
            margin-bottom: 22px;
        }

        .nav-group-label {
            font-size: 10.5px;
            text-transform: uppercase;
            letter-spacing: .1em;
            color: var(--subtitle);
            padding: 0 12px;
            margin-bottom: 8px;
            font-weight: 600;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 11px 12px;
            border-radius: 12px;
            font-size: 14px;
            font-weight: 500;
            color: var(--subtitle);
            margin-bottom: 2px;
            position: relative;
            transition: .2s;
            width: 100%;
            text-align: left;
        }

            .nav-item .ic {
                width: 20px;
                text-align: center;
                font-size: 15px;
                flex-shrink: 0;
            }

            .nav-item .badge {
                margin-left: auto;
                font-size: 10.5px;
                font-family: var(--font-mono);
                background: rgba(var(--danger-rgb),.15);
                color: var(--danger);
                padding: 2px 7px;
                border-radius: 100px;
            }

            .nav-item:hover {
                background: rgba(255,255,255,.05);
                color: var(--text);
            }

            .nav-item.active {
                background: linear-gradient(90deg,rgba(var(--primary-rgb),.16),rgba(var(--primary-rgb),.02));
                color: var(--text);
            }

                .nav-item.active::before {
                    content: '';
                    position: absolute;
                    left: 0;
                    top: 8px;
                    bottom: 8px;
                    width: 3px;
                    border-radius: 100px;
                    background: var(--grad-brand);
                }

        .sidebar-foot {
            padding: 16px;
            border-top: 1px solid var(--border);
        }

        .admin-mini {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px;
            border-radius: 12px;
            background: rgba(255,255,255,.03);
        }

            .admin-mini .av {
                width: 34px;
                height: 34px;
                border-radius: 50%;
                background: var(--grad-brand);
                flex-shrink: 0;
            }

            .admin-mini b {
                font-size: 13px;
                display: block;
            }

            .admin-mini span {
                font-size: 11px;
                color: var(--subtitle);
            }

        /* ---- main ---- */
        .main {
            flex: 1;
            margin-left: var(--sidebar-w);
            min-width: 0;
        }

        .topbar {
            position: sticky;
            top: 0;
            z-index: 40;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 16px 28px;
            border-bottom: 1px solid var(--border);
            background: rgba(15,17,23,.7);
            backdrop-filter: blur(16px);
        }

        [data-theme="light"] .topbar {
            background: rgba(255,255,255,.75);
        }

        .topbar-left {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .menu-toggle {
            display: none;
            width: 38px;
            height: 38px;
            border-radius: 10px;
            border: 1px solid var(--border-strong);
            align-items: center;
            justify-content: center;
        }

        .page-title {
            font-size: 19px;
        }

        .page-sub {
            font-size: 12.5px;
            color: var(--subtitle);
            margin-top: 1px;
        }

        .search-box {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 9px 16px;
            border-radius: 100px;
            border: 1px solid var(--border-strong);
            background: rgba(255,255,255,.03);
            width: 280px;
        }

            .search-box input {
                background: none;
                border: none;
                outline: none;
                font-size: 13.5px;
                width: 100%;
                color: var(--text);
            }

                .search-box input::placeholder {
                    color: var(--subtitle);
                }

        .topbar-right {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .icon-btn {
            width: 38px;
            height: 38px;
            border-radius: 10px;
            border: 1px solid var(--border-strong);
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            transition: .2s;
        }

            .icon-btn:hover {
                background: rgba(255,255,255,.06);
            }

            .icon-btn .dot {
                position: absolute;
                top: 7px;
                right: 7px;
                width: 7px;
                height: 7px;
                border-radius: 50%;
                background: var(--danger);
            }

        .theme-switch {
            position: relative;
        }

        .theme-btn {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 8px 12px;
            border-radius: 100px;
            border: 1px solid var(--border-strong);
            background: rgba(255,255,255,.03);
            font-size: 13px;
        }

        .theme-dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: var(--grad-brand);
        }

        .theme-menu {
            position: absolute;
            top: calc(100% + 10px);
            right: 0;
            width: 190px;
            padding: 8px;
            border-radius: var(--radius-md);
            opacity: 0;
            visibility: hidden;
            transform: translateY(-8px) scale(.97);
            transition: .25s cubic-bezier(.2,.8,.2,1);
            box-shadow: var(--shadow-lift);
            background: rgba(20,22,30,.9);
            backdrop-filter: blur(20px);
            border: 1px solid var(--border-strong);
            z-index: 60;
        }

        [data-theme="light"] .theme-menu {
            background: rgba(255,255,255,.95);
        }

        .theme-switch.open .theme-menu {
            opacity: 1;
            visibility: visible;
            transform: translateY(0) scale(1);
        }

        .theme-opt {
            display: flex;
            align-items: center;
            gap: 9px;
            width: 100%;
            padding: 9px 11px;
            border-radius: 9px;
            font-size: 13px;
        }

            .theme-opt:hover {
                background: rgba(255,255,255,.06);
            }

            .theme-opt.active {
                background: rgba(var(--primary-rgb),.12);
                color: var(--primary);
            }

            .theme-opt .sw {
                width: 14px;
                height: 14px;
                border-radius: 5px;
                flex-shrink: 0;
            }

        .content {
            padding: 28px;
        }

        .view {
            display: none;
        }

            .view.active {
                display: block;
                animation: fadein .35s ease;
            }

        @@keyframes fadein {
            from {
                opacity: 0;
                transform: translateY(6px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* ============ SHARED COMPONENTS ============ */
        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            padding: 10px 18px;
            border-radius: 11px;
            font-size: 13.5px;
            font-weight: 600;
            transition: .2s;
            white-space: nowrap;
        }

        .btn-primary {
            background: var(--grad-brand);
            color: #fff;
            box-shadow: 0 8px 22px -8px rgba(var(--primary-rgb),.55);
        }

            .btn-primary:hover {
                transform: translateY(-2px);
                box-shadow: 0 12px 28px -8px rgba(var(--primary-rgb),.7);
            }

        .btn-ghost {
            background: rgba(255,255,255,.03);
            border: 1px solid var(--border-strong);
        }

            .btn-ghost:hover {
                background: rgba(255,255,255,.07);
            }

        .btn-danger {
            background: rgba(var(--danger-rgb),.12);
            color: var(--danger);
            border: 1px solid rgba(var(--danger-rgb),.3);
        }

            .btn-danger:hover {
                background: rgba(var(--danger-rgb),.2);
            }

        .btn-sm {
            padding: 7px 13px;
            font-size: 12.5px;
            border-radius: 9px;
        }

        .btn-icon-only {
            width: 34px;
            height: 34px;
            padding: 0;
            border-radius: 9px;
            border: 1px solid var(--border-strong);
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

            .btn-icon-only:hover {
                background: rgba(255,255,255,.06);
            }

        .card {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            padding: 22px;
        }

        .view-head {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 24px;
            flex-wrap: wrap;
            gap: 14px;
        }

            .view-head h2 {
                font-size: 24px;
                margin-bottom: 4px;
            }

            .view-head p {
                color: var(--subtitle);
                font-size: 13.5px;
            }

        .head-actions {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }

        /* table */
        .table-card {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            overflow: hidden;
        }

        .table-toolbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 18px 20px;
            border-bottom: 1px solid var(--border);
            flex-wrap: wrap;
            gap: 12px;
        }

        .filter-chips {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }

        .f-chip {
            padding: 7px 14px;
            border-radius: 100px;
            font-size: 12.5px;
            border: 1px solid var(--border-strong);
            color: var(--subtitle);
        }

            .f-chip.active {
                background: var(--grad-brand);
                color: #fff;
                border-color: transparent;
            }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        thead th {
            text-align: left;
            font-size: 11.5px;
            text-transform: uppercase;
            letter-spacing: .06em;
            color: var(--subtitle);
            padding: 12px 20px;
            border-bottom: 1px solid var(--border);
            font-weight: 600;
            white-space: nowrap;
        }

        tbody td {
            padding: 14px 20px;
            font-size: 13.5px;
            border-bottom: 1px solid var(--border);
            white-space: nowrap;
        }

        tbody tr:last-child td {
            border-bottom: none;
        }

        tbody tr {
            transition: background .15s;
        }

            tbody tr:hover {
                background: rgba(255,255,255,.02);
            }

        .cell-main {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .cell-avatar {
            width: 34px;
            height: 34px;
            border-radius: 10px;
            background: var(--grad-brand);
            flex-shrink: 0;
        }

            .cell-avatar.round {
                border-radius: 50%;
            }

        .cell-title {
            font-weight: 600;
            font-size: 13.5px;
        }

        .cell-sub {
            font-size: 11.5px;
            color: var(--subtitle);
        }

        .badge {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 5px 11px;
            border-radius: 100px;
            font-size: 11.5px;
            font-weight: 600;
        }

            .badge.green {
                background: rgba(var(--accent-rgb),.14);
                color: var(--accent);
            }

            .badge.blue {
                background: rgba(var(--secondary-rgb),.16);
                color: var(--secondary);
            }

            .badge.orange {
                background: rgba(255,180,84,.16);
                color: var(--warn);
            }

            .badge.red {
                background: rgba(var(--danger-rgb),.14);
                color: var(--danger);
            }

            .badge.gray {
                background: rgba(255,255,255,.08);
                color: var(--subtitle);
            }

        .row-actions {
            display: flex;
            gap: 6px;
            justify-content: flex-end;
        }

        .table-foot {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 14px 20px;
            font-size: 12.5px;
            color: var(--subtitle);
        }

        .pager {
            display: flex;
            gap: 6px;
        }

            .pager button {
                width: 30px;
                height: 30px;
                border-radius: 8px;
                border: 1px solid var(--border-strong);
                font-size: 12.5px;
            }

                .pager button.active {
                    background: var(--grad-brand);
                    color: #fff;
                    border-color: transparent;
                }

        .mini-bar {
            width: 70px;
            height: 5px;
            border-radius: 100px;
            background: var(--card2);
            overflow: hidden;
            display: inline-block;
            vertical-align: middle;
            margin-right: 6px;
        }

            .mini-bar i {
                display: block;
                height: 100%;
                background: var(--grad-brand);
            }

        .empty-hint {
            text-align: center;
            padding: 50px 20px;
            color: var(--subtitle);
            font-size: 13.5px;
        }

        /* ============ RESPONSIVE ============ */
        @@media (max-width:900px) {
            .sidebar {
                transform: translateX(-100%);
            }

                .sidebar.open {
                    transform: translateX(0);
                }

            .main {
                margin-left: 0;
            }

            .menu-toggle {
                display: flex;
            }

            .search-box {
                display: none;
            }
        }

        @@media (max-width:640px) {
            .content {
                padding: 18px;
            }

            .topbar {
                padding: 14px 16px;
            }

            table {
                font-size: 12.5px;
            }

            thead th, tbody td {
                padding: 10px 12px;
            }
        }
        /* ======== FORM ======== */

        .f-row {
            display: flex;
            flex-direction: column;
            gap: 8px;
            margin-bottom: 18px;
        }

            .f-row label {
                font-size: 13px;
                font-weight: 600;
                color: var(--text);
            }

            .f-row input,
            .f-row textarea {
                width: 100%;
                background: var(--bg2);
                border: 1px solid var(--border);
                color: var(--text);
                padding: 12px 14px;
                border-radius: 10px;
                font-size: 14px;
                transition: .2s;
            }

            .f-row textarea {
                resize: vertical;
                min-height: 120px;
            }

                .f-row input:focus,
                .f-row textarea:focus {
                    border-color: var(--primary);
                    box-shadow: 0 0 0 3px rgba(var(--primary-rgb),.15);
                }

                .f-row input::placeholder,
                .f-row textarea::placeholder {
                    color: var(--subtitle);
                }

        .modal-foot {
            display: flex;
            gap: 12px;
            margin-top: 20px;
        }

        .switch {
            position: relative;
            width: 48px;
            height: 26px;
        }

            .switch input {
                display: none;
            }

            .switch .track {
                position: absolute;
                inset: 0;
                background: #555;
                border-radius: 100px;
                transition: .3s;
            }

                .switch .track::before {
                    content: "";
                    position: absolute;
                    width: 20px;
                    height: 20px;
                    border-radius: 50%;
                    background: #fff;
                    top: 3px;
                    left: 3px;
                    transition: .3s;
                }

            .switch input:checked + .track {
                background: var(--primary);
