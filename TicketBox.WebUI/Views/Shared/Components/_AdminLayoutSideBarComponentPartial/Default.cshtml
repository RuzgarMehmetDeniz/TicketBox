@{
    // Şu an hangi controller'da olduğumuzu bul (nav item'ın "active" olup olmayacağını belirlemek için)
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
}
<aside class="sidebar" id="sidebar">
    <div class="sidebar-head">
        <div class="logo-mark">TB</div>
        <div class="logo-text">TicketBox<span>ADMIN PANEL</span></div>
    </div>
    <nav class="nav-scroll">
        <div class="nav-group">
            <div class="nav-group-label">İçerik Yönetimi</div>

            <!-- Etkinlikler — kendi Controller/Action adını buraya yaz -->
            <a class="nav-item @(currentController == "AdminEvent" ? "active" : "")"
               href="@Url.Action("EventList", "AdminEvent")">
                <span class="ic">🎟️</span> Etkinlikler
            </a>

            <!-- Kategoriler -->
            <a class="nav-item @(currentController == "AdminCategory" ? "active" : "")"
               href="@Url.Action("CategoryList", "AdminCategory")">
                <span class="ic">🔷</span> Kategoriler
            </a>

            <!-- Yeni entity eklerken buraya aynı formatta bir <a> daha ekle -->
        </div>
    </nav>
    <div class="sidebar-foot">
        <div class="admin-mini">
            <div class="av"></div>
            <div><b>Merve Aydın</b><span>Süper Yönetici</span></div>
        </div>
    </div>
</aside>
