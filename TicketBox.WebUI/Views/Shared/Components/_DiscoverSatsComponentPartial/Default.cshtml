@model PlatformStatsViewModel

<section class="section" id="stats">
	<div class="wrap">
		<div class="stats-band reveal">
			<div class="stats-grid">
				<div class="stat">
					<b class="counter" data-target="@Model.TotalEvents">0</b>
					<span>Toplam Etkinlik</span>
				</div>
				<div class="stat">
					<b class="counter" data-target="@Model.SoldTickets">0</b>
					<span>Satılan Bilet</span>
				</div>
				<div class="stat">
					<b class="counter" data-target="@Model.CityCount">0</b>
					<span>Şehirde Hizmet</span>
				</div>
				<div class="stat">
					<b class="counter" data-target="@Model.OrganizerCount">0</b>
					<span>Organizatör</span>
				</div>
			</div>
		</div>
	</div>
</section>