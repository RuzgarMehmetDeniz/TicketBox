@model List<UpComingEventCardViewModel>

<section class="section" id="upcoming">
	<div class="wrap">
		<div class="events-toolbar reveal">
			<h2>Yaklaşan etkinlikler</h2>
			<div class="carousel-nav">
				<button class="icon-btn" id="carPrev">‹</button>
				<button class="icon-btn" id="carNext">›</button>
			</div>
		</div>
	</div>
	<div class="carousel-outer">
		<div class="carousel" id="carousel">
			@foreach (var e in Model)
			{
				<div class="event-card reveal">
					<div class="ev-media">
						<div class="img" style="@(string.IsNullOrEmpty(e.ImageUrl) ? "" : $"background-image:url('{e.ImageUrl}');background-size:cover;background-position:center;")"></div>
						<span class="ev-badge">@e.CategoryName</span>
						<button class="ev-fav">♥</button>
						<div class="ev-date-flag">
							<b>@e.EventDate.Day</b>
							<span>@e.EventDate.ToString("MMM").ToUpper()</span>
						</div>
						@if (e.IsLive)
						{
							<div class="ev-live"><i></i> Canlı ilgi</div>
						}
					</div>
					<div class="ev-body">
						<div class="ev-cat">@e.CategoryName</div>
						<h3>@e.Title</h3>
						<div class="ev-meta">
							<span>📍 @e.Location</span>
							<span>🕒 @e.EventDate.ToString("HH:mm")</span>
						</div>
						<div class="ev-org">
							<div class="av"></div>
							<span>@e.OrganizerName</span>
							<span class="rating">★ @e.AverageRating</span>
						</div>
						<div class="ev-fill"><i style="width:@(e.FillPercentage)%;"></i></div>
						<div class="ev-fill-label">
							<span>@e.FillPercentage% dolu</span>
							<span>👥 @e.AttendeeCount katılımcı</span>
						</div>
						<div class="ev-foot">
							<div class="ev-price"><b>₺@e.Price</b><span>başlangıç fiyatı</span></div>
							<div class="ev-actions">
								<button class="icon-btn" title="QR">▤</button>
								<button class="icon-btn" title="Paylaş">↗</button>
							</div>
						</div>
					</div>
				</div>
			}
		</div>
	</div>
</section>