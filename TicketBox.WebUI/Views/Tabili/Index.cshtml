
@{
    ViewData["Title"] = "Tabili AI";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="tabili-page">
    <div class="tabili-header">
        <h1>🔮 Tabili AI</h1>
        <p>Platform verilerinle ilgili doğal dilde soru sor, gerçek zamanlı cevap al.</p>
    </div>

    <form id="afTokenTabili" style="display:none">@Html.AntiForgeryToken()</form>

    <div class="tabili-suggestions">
        <button type="button" class="tabili-chip" onclick="askTabili('Bu ay toplam gelir ne kadar?')">Bu ay toplam gelir ne kadar?</button>
        <button type="button" class="tabili-chip" onclick="askTabili('En çok satan 5 etkinlik hangisi?')">En çok satan 5 etkinlik hangisi?</button>
        <button type="button" class="tabili-chip" onclick="askTabili('Hangi kategori en çok gelir getiriyor?')">Kategori bazlı gelir</button>
        <button type="button" class="tabili-chip" onclick="askTabili('Son 6 ayın satış trendini göster')">Son 6 ay trend</button>
        <button type="button" class="tabili-chip" onclick="askTabili('İade istatistikleri nasıl?')">İade istatistikleri</button>
    </div>

    <div class="tabili-chat" id="tabiliChat">
        <div class="tabili-msg bot">Merhaba! Ben Tabili AI. Platform verilerinle ilgili bana soru sorabilirsin — örneğin "bu ay en çok satan etkinlik hangisi?" gibi.</div>
    </div>

    <form class="tabili-input" id="tabiliForm">
        <input type="text" id="tabiliInput" placeholder="Bir soru yaz..." autocomplete="off" />
        <button type="submit">Sor</button>
    </form>
</div>

<style>
    .tabili-page {
        max-width: 760px;
        margin: 0 auto;
        padding: 32px 20px;
    }

    .tabili-header h1 {
        font-size: 26px;
        margin-bottom: 6px;
    }

    .tabili-header p {
        color: var(--subtitle, #94a3b8);
        font-size: 14px;
        margin-bottom: 24px;
    }

    .tabili-suggestions {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 24px;
    }

    .tabili-chip {
        font-size: 12.5px;
        padding: 8px 14px;
        border-radius: 100px;
        border: 1px solid rgba(255,255,255,.15);
        background: rgba(255,255,255,.03);
        color: inherit;
        cursor: pointer;
        transition: .2s;
    }

        .tabili-chip:hover {
            background: rgba(255,255,255,.08);
        }

    .tabili-chat {
        display: flex;
        flex-direction: column;
        gap: 12px;
        min-height: 320px;
        max-height: 520px;
        overflow-y: auto;
        padding: 20px;
        border: 1px solid rgba(255,255,255,.1);
        border-radius: 14px;
        background: rgba(255,255,255,.02);
        margin-bottom: 16px;
    }

    .tabili-msg {
        max-width: 85%;
        padding: 12px 16px;
        border-radius: 12px;
        font-size: 14px;
        line-height: 1.6;
        white-space: pre-line;
    }

        .tabili-msg.bot {
            align-self: flex-start;
            background: rgba(255,255,255,.06);
        }

        .tabili-msg.user {
            align-self: flex-end;
            background: linear-gradient(135deg,#6D5DFC,#8B7CFF);
            color: #fff;
        }

        .tabili-msg.typing {
            opacity: .6;
            font-style: italic;
        }

    .tabili-input {
        display: flex;
        gap: 10px;
    }

        .tabili-input input {
            flex: 1;
            padding: 14px 16px;
            border-radius: 10px;
            border: 1px solid rgba(255,255,255,.15);
            background: rgba(255,255,255,.03);
            color: inherit;
            font-size: 14px;
        }

        .tabili-input button {
            padding: 0 22px;
            border-radius: 10px;
            border: none;
            background: linear-gradient(135deg,#6D5DFC,#8B7CFF);
            color: #fff;
            font-weight: 600;
            cursor: pointer;
        }
</style>

<script>
    const tabiliChat = document.getElementById('tabiliChat');
    const tabiliForm = document.getElementById('tabiliForm');
    const tabiliInput = document.getElementById('tabiliInput');

    function getTabiliToken() {
        return document.querySelector('#afTokenTabili input[name="__RequestVerificationToken"]').value;
    }

    function appendTabiliMessage(sender, content) {
        const div = document.createElement('div');
        div.className = 'tabili-msg ' + (sender === 'user' ? 'user' : 'bot');
        div.textContent = content;
        tabiliChat.appendChild(div);
        tabiliChat.scrollTop = tabiliChat.scrollHeight;
    }

    async function askTabili(question) {
        appendTabiliMessage('user', question);

        const typingEl = document.createElement('div');
        typingEl.className = 'tabili-msg bot typing';
        typingEl.textContent = 'Veriler analiz ediliyor...';
        tabiliChat.appendChild(typingEl);
        tabiliChat.scrollTop = tabiliChat.scrollHeight;

        try {
            const res = await fetch('/Tabili/Ask', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: '__RequestVerificationToken=' + encodeURIComponent(getTabiliToken()) + '&question=' + encodeURIComponent(question)
            });
            const data = await res.json();
            typingEl.remove();

            appendTabiliMessage('bot', data.success ? data.answer : ('Hata: ' + data.error));
        } catch (err) {
            typingEl.remove();
            appendTabiliMessage('bot', 'Bağlantı hatası, tekrar deneyin.');
        }
    }

    tabiliForm.addEventListener('submit', function (e) {
        e.preventDefault();
        const q = tabiliInput.value.trim();
        if (!q) return;
        tabiliInput.value = '';
        askTabili(q);
    });
</script>